---
import { AuthProvider } from '../auth/AuthContext';
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { 
  title = "OdontoCare - Sistema de Gestión para Clínicas Dentales",
  description = "Sistema integral para la gestión de clínicas dentales"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-white dark:bg-gray-900">
    <AuthProvider client:load>
      <slot />
    </AuthProvider>
    <script>
      // Gestión del tema oscuro/claro
      const handleThemeChange = () => {
        const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
        const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');

        // Cambiar los iconos dentro del botón según el tema
        if (localStorage.getItem('color-theme') === 'dark' || 
            (!('color-theme' in localStorage) && 
            window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          themeToggleLightIcon?.classList.remove('hidden');
          themeToggleDarkIcon?.classList.add('hidden');
          document.documentElement.classList.add('dark');
        } else {
          themeToggleDarkIcon?.classList.remove('hidden');
          themeToggleLightIcon?.classList.add('hidden');
          document.documentElement.classList.remove('dark');
        }
      };

      // Escuchar cambios en el tema
      document.addEventListener('astro:after-swap', handleThemeChange);

      // Inicializar el tema al cargar
      handleThemeChange();
    </script>
  </body>
</html>