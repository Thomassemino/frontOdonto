---
import LayoutCommon from "../../app/LayoutCommon.astro";
import LayoutProtected from "../../app/LayoutProtected.astro";

const { dni } = Astro.params;
---

<LayoutProtected>
  <LayoutCommon>
    <div class="min-h-screen bg-gradient-to-r from-slate-100 to-slate-200 p-4 dark:from-slate-900 dark:to-slate-800 lg:p-16">
      <div class="mx-auto max-w-7xl">
        <!-- Header -->
        <div class="mb-8 flex items-center justify-between">
          <div class="flex items-center space-x-4">
            <button id="volverBtn" class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300">
              ← Volver
            </button>
            <h1 class="text-3xl font-bold text-slate-800 dark:text-slate-100">Perfil del Paciente</h1>
          </div>
        </div>

        <!-- Información Principal -->
        <div class="mb-8 grid gap-6 lg:grid-cols-2">
          <!-- Datos Personales -->
          <div class="rounded-lg bg-white p-6 shadow-lg dark:bg-gray-800">
            <h2 class="mb-4 text-xl font-semibold text-slate-800 dark:text-slate-100">Datos Personales</h2>
            <div class="space-y-4" id="datosPersonales">
              <!-- Se llena dinámicamente -->
            </div>
          </div>

          <!-- Información de Contacto -->
          <div class="rounded-lg bg-white p-6 shadow-lg dark:bg-gray-800">
            <h2 class="mb-4 text-xl font-semibold text-slate-800 dark:text-slate-100">Información de Contacto</h2>
            <div class="space-y-4" id="infoContacto">
              <!-- Se llena dinámicamente -->
            </div>
          </div>
        </div>

        <!-- Historia Clínica -->
        <div class="rounded-lg bg-white p-6 shadow-lg dark:bg-gray-800">
          <h2 class="mb-6 text-2xl font-semibold text-slate-800 dark:text-slate-100">Historia Clínica</h2>
          <div class="space-y-8" id="historiaClinica">
            <!-- Secciones de Historia Clínica -->
          </div>
        </div>
      </div>
    </div>
  </LayoutCommon>
</LayoutProtected>

<script type="module" define:vars={{ dni }}>
const BASE_URL = import.meta.env.PUBLIC_BASE_URL || "https://odontoback-production.up.railway.app/api";
async function cargarPerfil() {
  try {
    console.log('Cargando perfil para DNI:', dni);
    const pacienteResponse = await fetch(`${BASE_URL}/paciente/findByDni/${dni}`);
    console.log('Respuesta del servidor:', pacienteResponse);
    
    if (!pacienteResponse.ok) throw new Error('Paciente no encontrado');
    
    const pacienteData = await pacienteResponse.json();
    console.log('Datos del paciente:', pacienteData);
    const paciente = pacienteData.paciente;

    if (paciente.historiaClinica) {
      const hcResponse = await fetch(`${BASE_URL}/historiaClinica/getHc/${paciente.historiaClinica}`);
      if (!hcResponse.ok) throw new Error('Historia clínica no encontrada');
      
      const hcData = await hcResponse.json();
      const historiaClinica = hcData.historiaClinica;
      renderizarHistoriaClinica(historiaClinica);
    }

    renderizarDatosPersonales(paciente);
    renderizarInfoContacto(paciente);
  } catch (error) {
    console.error('Error:', error);
    mostrarNotificacion(error.message, 'error');
  }
}

function renderizarDatosPersonales(paciente) {
  const container = document.getElementById('datosPersonales');
  container.innerHTML = `
    <div class="grid gap-4">
      <div>
        <label class="text-sm font-medium text-gray-500 dark:text-gray-400">Nombre Completo</label>
        <p class="text-gray-900 dark:text-white">${paciente.nombre || 'No especificado'}</p>
      </div>
      <div>
        <label class="text-sm font-medium text-gray-500 dark:text-gray-400">DNI</label>
        <p class="text-gray-900 dark:text-white">${paciente.dni || 'No especificado'}</p>
      </div>
    </div>
  `;
}

function renderizarInfoContacto(paciente) {
  const container = document.getElementById('infoContacto');
  container.innerHTML = `
    <div class="grid gap-4">
      <div>
        <label class="text-sm font-medium text-gray-500 dark:text-gray-400">Email</label>
        <p class="text-gray-900 dark:text-white">${paciente.mail || 'No especificado'}</p>
      </div>
      <div>
        <label class="text-sm font-medium text-gray-500 dark:text-gray-400">Teléfono</label>
        <p class="text-gray-900 dark:text-white">${paciente.areaCode || ''} ${paciente.telefono || 'No especificado'}</p>
      </div>
      <div>
        <label class="text-sm font-medium text-gray-500 dark:text-gray-400">Dirección</label>
        <p class="text-gray-900 dark:text-white">${paciente.direccion || 'No especificada'}</p>
      </div>
    </div>
  `;
}

function renderizarHistoriaClinica(hc) {
  const container = document.getElementById('historiaClinica');
  if (!hc) {
    container.innerHTML = '<p class="text-gray-500 dark:text-gray-400">No hay historia clínica disponible</p>';
    return;
  }
  
  container.innerHTML = `
    <div class="space-y-8">
      <!-- Datos Personales Médicos -->
      <div class="rounded-lg border border-gray-200 p-6 dark:border-gray-700">
        <h3 class="mb-4 text-lg font-semibold text-slate-800 dark:text-slate-100">Datos Personales Médicos</h3>
        <div class="grid gap-4 md:grid-cols-2">
          ${renderizarCampo('Enfermedades', hc.datosPersonalesMedicos?.enfermedades)}
          ${renderizarCampo('Tratamiento Actual', hc.datosPersonalesMedicos?.tratamientoActual)}
          ${renderizarCampo('Medicamentos', hc.datosPersonalesMedicos?.medicamentosRegulares)}
          ${renderizarCampo('Enfermedad Infecto-Infecciosa', hc.datosPersonalesMedicos?.enfermedadInfectoInfecciosa)}
          ${renderizarCampo('Alergias', hc.datosPersonalesMedicos?.alergias)}
          ${renderizarCampo('Diabetes', hc.datosPersonalesMedicos?.diabetes ? 'Sí' : 'No')}
          ${renderizarCampo('Fuma', hc.datosPersonalesMedicos?.fuma ? 'Sí' : 'No')}
          ${renderizarCampo('Embarazo', hc.datosPersonalesMedicos?.embarazo ? 'Sí' : 'No')}
          ${renderizarCampo('Motivo de Consulta', hc.datosPersonalesMedicos?.motivoConsulta)}
        </div>
      </div>

      <!-- Antecedentes Médicos Odontológicos -->
      <div class="rounded-lg border border-gray-200 p-6 dark:border-gray-700">
        <h3 class="mb-4 text-lg font-semibold text-slate-800 dark:text-slate-100">Antecedentes Médicos Odontológicos</h3>
        <div class="grid gap-4 md:grid-cols-2">
          ${renderizarCampo('Consultó Odontólogo', hc.antecedentesMedicosOdontologicos?.consultoOdontologo ? 'Sí' : 'No')}
          ${renderizarCampo('Tratamiento Odontológico', hc.antecedentesMedicosOdontologicos?.tratamientoOdontologico?.descripcion)}
          ${renderizarCampo('Dolor', formatearDolor(hc.antecedentesMedicosOdontologicos?.dolor))}
          ${renderizarCampo('Fractura de Diente', hc.antecedentesMedicosOdontologicos?.fracturaDiente)}
          ${renderizarCampo('Dificultad para Masticar', hc.antecedentesMedicosOdontologicos?.dificultadMasticar ? 'Sí' : 'No')}
          ${renderizarCampo('Dificultad para Abrir la Boca', hc.antecedentesMedicosOdontologicos?.dificultadAbrirBoca ? 'Sí' : 'No')}
        </div>
      </div>

      <!-- Estado Actual -->
      <div class="rounded-lg border border-gray-200 p-6 dark:border-gray-700">
        <h3 class="mb-4 text-lg font-semibold text-slate-800 dark:text-slate-100">Estado Actual</h3>
        <div class="grid gap-4 md:grid-cols-2">
          ${renderizarCampo('Anormalidad en Boca', hc.estadoActual?.anormalidadBoca)}
          ${renderizarCampo('Sangrado de Encías', hc.estadoActual?.sangradoEncias ? 'Sí' : 'No')}
          ${renderizarCampo('Hinchazón en la Cara', hc.estadoActual?.hinchazonCara ? 'Sí' : 'No')}
          ${renderizarCampo('Higiene Bucal', hc.estadoActual?.higieneBucal)}
        </div>
      </div>

      <!-- Aclaraciones -->
      <div class="rounded-lg border border-gray-200 p-6 dark:border-gray-700">
        <h3 class="mb-4 text-lg font-semibold text-slate-800 dark:text-slate-100">Aclaraciones Finales del Médico</h3>
        <p class="text-gray-700 dark:text-gray-300">${hc.aclaracionesFinalesMedico || 'Sin aclaraciones'}</p>
      </div>
    </div>
  `;
}

function renderizarCampo(label, valor) {
  return `
    <div>
      <label class="text-sm font-medium text-gray-500 dark:text-gray-400">${label}</label>
      <p class="text-gray-900 dark:text-white">${valor || 'No especificado'}</p>
    </div>
  `;
}

function formatearDolor(dolorStr) {
  try {
    if (!dolorStr) return 'No especificado';
    
    const dolor = JSON.parse(dolorStr);
    const parts = [];
    
    if (dolor.rango) parts.push(`Intensidad: ${dolor.rango}`);
    if (dolor.tipo) parts.push(`Tipo: ${dolor.tipo}`);
    
    if (dolor.caracteristicas && dolor.caracteristicas.length > 0) {
      parts.push(`Características: ${dolor.caracteristicas.join(', ')}`);
    }
    
    if (dolor.sensibilidad && dolor.sensibilidad.length > 0) {
      parts.push(`Sensibilidad: ${dolor.sensibilidad.join(', ')}`);
    }
    
    if (dolor.localizacion) {
      const localizacion = dolor.localizacion
        .replace(/([A-Z])/g, ' $1')
        .toLowerCase()
        .replace(/^./, str => str.toUpperCase());
      parts.push(`Localización: ${localizacion}`);
    }
    return parts.join('. ') || 'No especificado';
  } catch (e) {
    return dolorStr || 'No especificado';
  }
}

function mostrarNotificacion(mensaje, tipo = 'success') {
  const notificacionExistente = document.querySelector('.notification');
  if (notificacionExistente) notificacionExistente.remove();

  const notificacion = document.createElement('div');
  const bgColor = tipo === 'success' ? 'bg-green-500' : 'bg-red-500';
  
  notificacion.className = `notification fixed top-4 right-4 p-4 rounded-lg shadow-lg z-50 text-white ${bgColor} transition-opacity duration-300`;
  notificacion.textContent = mensaje;
  
  document.body.appendChild(notificacion);
  setTimeout(() => {
    notificacion.style.opacity = '0';
    setTimeout(() => notificacion.remove(), 300);
  }, 3000);
}

// Inicialización
document.addEventListener('DOMContentLoaded', () => {
  cargarPerfil();

  document.getElementById('volverBtn')?.addEventListener('click', () => {
    window.history.back();
  });
});

// Al final del script
document.addEventListener('astro:page-load', () => {
  console.log('Página cargada, iniciando carga de perfil...');
  cargarPerfil();
});
</script>