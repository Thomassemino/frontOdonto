---
import PageLayout from "../../components/layouts/PageLayout.astro";
import SearchInput from "../../components/common/SearchInput";
import Table from "../../components/common/Table";
import Modal from "../../components/common/Modal";
---

<PageLayout title="Tratamientos">
  <div slot="header-actions">
    <button
      id="createTreatmentButton"
      class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
    >
      <svg
        class="mr-2 h-4 w-4"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 4v16m8-8H4"
        />
      </svg>
      Nuevo Tratamiento
    </button>
  </div>

  <!-- Search -->
  <div class="mb-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    <SearchInput
      label="Buscar Tratamiento"
      placeholder="Buscar por nombre o descripción..."
    />
  </div>

  <!-- Desktop Table -->
  <Table
    columns={[
      { header: "Nombre" },
      { header: "Descripción" },
      { header: "Acciones" }
    ]}
  >
    <tbody id="tratamientosTableBodyDesktop">
      <!-- Filled dynamically -->
    </tbody>
  </Table>

  <!-- Mobile Cards -->
  <div class="md:hidden space-y-4" id="tratamientosTableBodyMobile">
    <!-- Filled dynamically -->
  </div>

  <!-- Edit Modal -->
  <Modal id="editModal" title="Editar Tratamiento">
    <form id="editForm" class="space-y-4">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
            Nombre
          </label>
          <input
            type="text"
            name="nombre"
            required
            class="mt-1 block w-full rounded-md border border-gray-300 bg-white p-2 text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-white focus:border-blue-500 focus:ring-blue-500"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
            Descripción
          </label>
          <textarea
            name="descripcion"
            required
            rows="3"
            class="mt-1 block w-full rounded-md border border-gray-300 bg-white p-2 text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-white focus:border-blue-500 focus:ring-blue-500"
          ></textarea>
        </div>
      </div>

      <div class="flex justify-end space-x-4 pt-4">
        <button
          type="button"
          class="close-modal px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-700 dark:text-gray-300 dark:hover:text-gray-200"
        >
          Cancelar
        </button>
        <button
          type="submit"
          class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
        >
          Guardar
        </button>
      </div>
    </form>
  </Modal>

  <!-- Create Modal -->
  <Modal id="createModal" title="Nuevo Tratamiento">
    <form id="createForm" class="space-y-4">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
            Nombre
          </label>
          <input
            type="text"
            name="nombre"
            required
            placeholder="Nombre del tratamiento"
            class="mt-1 block w-full rounded-md border border-gray-300 bg-white p-2 text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-white focus:border-blue-500 focus:ring-blue-500"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
            Descripción
          </label>
          <textarea
            name="descripcion"
            required
            rows="3"
            placeholder="Descripción detallada del tratamiento"
            class="mt-1 block w-full rounded-md border border-gray-300 bg-white p-2 text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-white focus:border-blue-500 focus:ring-blue-500"
          ></textarea>
        </div>
      </div>

      <div class="flex justify-end space-x-4 pt-4">
        <button
          type="button"
          class="close-modal px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-700 dark:text-gray-300 dark:hover:text-gray-200"
        >
          Cancelar
        </button>
        <button
          type="submit"
          class="px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 focus:ring-4 focus:ring-green-300 dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800"
        >
          Crear
        </button>
      </div>
    </form>
  </Modal>
</PageLayout>

<script>
import { showNotification } from '../../utils/notifications';
import { fetchData } from '../../utils/api';
import { modalStore } from '../../stores/modalStore';

// Estado
const state = {
  selectedTreatment: null
};

// Validaciones
const validateTreatment = (treatment: { nombre: any; descripcion: any; }) => {
  const errors = [];
  if (!treatment.nombre.trim()) errors.push('El nombre es requerido');
  if (!treatment.descripcion.trim()) errors.push('La descripción es requerida');
  return errors;
};

// Funciones de renderizado
function renderizarVistas(tratamientos: any[]) {
  const tbodyDesktop = document.getElementById('tratamientosTableBodyDesktop');
  const containerMobile = document.getElementById('tratamientosTableBodyMobile');
  
  if (!tbodyDesktop || !containerMobile) return;

  // Vista Desktop
  tbodyDesktop.innerHTML = tratamientos.map((row: { _id: any; nombre: any; descripcion: any; }) => `
    <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-150"
        data-id="${row._id}"
        data-nombre="${row.nombre}"
        data-descripcion="${row.descripcion}">
      <td class="px-6 py-4 text-sm text-gray-900 dark:text-gray-100">${row.nombre}</td>
      <td class="px-6 py-4 text-sm text-gray-900 dark:text-gray-100">${row.descripcion}</td>
      <td class="px-6 py-4">
        <div class="flex space-x-2">
          <button class="edit-button p-2 text-blue-600 hover:text-blue-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" 
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
          </button>
          <button class="delete-button p-2 text-red-600 hover:text-red-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" 
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 6h18"/>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>
              <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
            </svg>
          </button>
        </div>
      </td>
    </tr>
  `).join('');

  // Vista Mobile
  containerMobile.innerHTML = tratamientos.map((row: { _id: any; nombre: any; descripcion: any; }) => `
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-4 space-y-3"
         data-id="${row._id}"
         data-nombre="${row.nombre}"
         data-descripcion="${row.descripcion}">
      <div class="flex justify-between items-start">
        <div class="space-y-1">
          <div class="font-medium text-gray-900 dark:text-white">${row.nombre}</div>
        </div>
        <div class="flex space-x-2">
          <button class="edit-button p-2 text-blue-600 hover:text-blue-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" 
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
          </button>
          <button class="delete-button p-2 text-red-600 hover:text-red-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" 
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 6h18"/>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>
              <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
            </svg>
          </button>
        </div>
      </div>
      
      <div class="text-sm">
        <p class="text-gray-900 dark:text-gray-100">${row.descripcion}</p>
      </div>
    </div>
  `).join('');

  setupEventListeners();
}

// Funciones CRUD
async function actualizarTabla() {
  try {
    const data = await fetchData('/tratamientos');
    renderizarVistas(data);
  } catch (error) {
    showNotification('Error al cargar los tratamientos', 'error');
  }
}

async function filtrarTratamientos() {
  try {
    const data = await fetchData('/tratamientos');
    const searchTerm = document.getElementById('searchInput')?.value.toLowerCase().trim();
    
    const tratamientosFiltrados = !searchTerm 
      ? data 
      : data.filter((tratamiento: { nombre: string; descripcion: string; }) => 
          tratamiento.nombre.toLowerCase().includes(searchTerm) ||
          tratamiento.descripcion.toLowerCase().includes(searchTerm)
        );

    renderizarVistas(tratamientosFiltrados);
  } catch (error) {
    showNotification('Error al filtrar los tratamientos', 'error');
  }
}

async function handleCreate(formData: FormData) {
  const treatment = {
    nombre: formData.get('nombre')?.toString().trim(),
    descripcion: formData.get('descripcion')?.toString().trim()
  };

  const errors = validateTreatment(treatment);
  if (errors.length > 0) {
    throw new Error(errors.join('\n'));
  }

  await fetchData('/tratamientos/create', {
    method: 'POST',
    body: JSON.stringify(treatment)
  });

  showNotification('Tratamiento creado correctamente');
  await actualizarTabla();
  modalStore.closeModal('createModal');
}

async function handleEdit(formData: FormData) {
  const id = state.selectedTreatment.id;
  const treatment = {
    nombre: formData.get('nombre')?.toString().trim(),
    descripcion: formData.get('descripcion')?.toString().trim()
  };

  const errors = validateTreatment(treatment);
  if (errors.length > 0) {
    throw new Error(errors.join('\n'));
  }

  await fetchData(`/tratamientos/updateById/${id}`, {
    method: 'PUT',
    body: JSON.stringify(treatment)
  });

  showNotification('Tratamiento actualizado correctamente');
  await actualizarTabla();
  modalStore.closeModal('editModal');
}

async function handleDelete(id: any, nombre: any) {
  if (!confirm(`¿Está seguro que desea eliminar el tratamiento "${nombre}"?`)) {
    return;
  }

  try {
    await fetchData(`/tratamientos/deleteById/${id}`, {
      method: 'DELETE'
    });

    showNotification('Tratamiento eliminado correctamente');
    await actualizarTabla();
  } catch (error) {
    showNotification(error.message, 'error');
  }
}

// Event Listeners y Setup
function setupEventListeners() {
  document.removeEventListener('click', handleButtonClick);
  document.addEventListener('click', handleButtonClick);
}

async function handleButtonClick(e: { target: { closest: (arg0: string) => any; }; }) {
  const editButton = e.target.closest('.edit-button');
  const deleteButton = e.target.closest('.delete-button');

  if (editButton) {
    const container = editButton.closest('[data-id]');
    if (container) {
      const treatment = {
        id: container.dataset.id,
        nombre: container.dataset.nombre,
        descripcion: container.dataset.descripcion
      };
      state.selectedTreatment = treatment;
      modalStore.openModal('editModal');
      
      const form = document.getElementById('editForm');
      if (form) {
        form.elements.nombre.value = treatment.nombre;
        form.elements.descripcion.value = treatment.descripcion;
      }
    }
  }

  if (deleteButton) {
    const container = deleteButton.closest('[data-id]');
    if (container) {
      const id = container.dataset.id;
      const nombre = container.dataset.nombre;
      await handleDelete(id, nombre);
    }
  }
}

// Inicialización
document.addEventListener('DOMContentLoaded', () => {
  // Registrar modales
  modalStore.registerModal('editModal');
  modalStore.registerModal('createModal');

  // Cargar datos iniciales
  actualizarTabla();

  // Event Listeners
  document.getElementById('searchInput')?.addEventListener('input', filtrarTratamientos);
  
  document.getElementById('createTreatmentButton')?.addEventListener('click', () => {
    modalStore.openModal('createModal');
  });

  // Event Listeners para formularios
  document.getElementById('createForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    try {
      await handleCreate(new FormData(e.target));
    } catch (error) {
      showNotification(error.message, 'error');
    }
  });

  document.getElementById('editForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    try {
      await handleEdit(new FormData(e.target));
    } catch (error) {
      showNotification(error.message, 'error');
    }
  });

  // Event Listeners para cerrar modales con Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      modalStore.closeModal('editModal');
      modalStore.closeModal('createModal');
    }
  });

  // Event Listeners para botones de cerrar modal
  document.querySelectorAll('.close-modal').forEach(button => {
    button.addEventListener('click', () => {
      modalStore.closeModal('editModal');
      modalStore.closeModal('createModal');
    });
  });

  // Event Listener para botón volver
  document.getElementById('volverBtn')?.addEventListener('click', () => {
    window.location.href = '/';
  });
});