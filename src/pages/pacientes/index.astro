---
import LayoutSidebar from '../../components/layouts/LayoutSidebar.astro';
import { PacientesTable } from '../../modules/pacientes';
---

<LayoutSidebar title="OdontoCare - Gestión de Pacientes" allowedRoles={['secretaria', 'odontologo', 'admin']}>
  <div class="mb-4">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Gestión de Pacientes</h1>
    <p class="text-gray-600 dark:text-gray-400">
      Administra la información de los pacientes de la clínica
    </p>
  </div>

  <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-4 md:p-6 mb-4">
    <PacientesTable client:load />
  </div>
</LayoutSidebar>