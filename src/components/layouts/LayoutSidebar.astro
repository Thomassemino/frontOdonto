---
import SidebarLayout from './SidebarLayout';
import LayoutProtected from './LayoutProtected.astro';

interface Props {
  title?: string;
  allowedRoles?: string[];
}

const { 
  title = "OdontoCare - Panel de Control",
  allowedRoles = [] 
} = Astro.props;
---

<LayoutProtected allowedRoles={allowedRoles}>
  <html lang="es">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <meta name="generator" content={Astro.generator} />
      <title>{title}</title>
    </head>
    <body>
      <SidebarLayout client:load>
        <slot />
      </SidebarLayout>
    </body>
  </html>
</LayoutProtected>