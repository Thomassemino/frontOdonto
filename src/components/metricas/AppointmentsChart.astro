---
import AppointmentsChartReact from './AppointmentsChartReact';

// Puedes pasar los datos como prop o conseguirlos de donde sea necesario
const initialData = [
  { name: 'Enero', value: 0 },
  { name: 'Febrero', value: 0 },
  { name: 'Marzo', value: 0},
  { name: 'Abril', value: 0},
  { name: 'Mayo', value: 0},
  { name: 'Junio', value: 0},
  { name: 'Julio', value: 0},
  { name: 'Agosto', value: 0},
  { name: 'Septiembre', value: 0},
  { name: 'Octubre', value: 0},
  { name: 'Noviembre', value: 0},
  { name: 'Diciembre', value: 0},
];
---

<div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6">
  <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-4">
    Citas por Mes
  </h3>
  <div class="w-full h-64">
    <AppointmentsChartReact client:load data={initialData} />
  </div>
</div>