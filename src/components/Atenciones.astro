---
// TableAtenciones.astro
interface Props {
  dni: string;
}

const { dni } = Astro.props;
---

<div class="space-y-6">
  <!-- Header con título y botón -->
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-semibold text-slate-800 dark:text-slate-100 sm:text-xl">
      Atenciones
    </h2>
    <button
      id="nuevaAtencionBtn"
      class="rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600"
    >
      Nueva Atención
    </button>
  </div>

  <!-- Tabla de Atenciones -->
  <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700">
    <table class="w-full table-auto border-collapse">
      <thead>
        <tr class="border-b border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-800">
          <th class="px-4 py-2 text-left text-gray-700 dark:text-gray-200">Fecha</th>
          <th class="px-4 py-2 text-left text-gray-700 dark:text-gray-200">Profesional</th>
          <th class="px-4 py-2 text-left text-gray-700 dark:text-gray-200">Notas</th>
          <th class="px-4 py-2 text-right text-gray-700 dark:text-gray-200">Acciones</th>
        </tr>
      </thead>
      <tbody id="atencionesTableBody" class="divide-y divide-gray-200 dark:divide-gray-700">
        <!-- Las filas se agregarán dinámicamente -->
      </tbody>
    </table>
  </div>

  <!-- Modal Nueva Atención -->
  <div
    id="atencionModal"
    class="fixed left-0 top-0 z-50 hidden h-full w-full bg-black bg-opacity-50"
  >
    <div class="absolute left-1/2 top-1/2 w-full max-w-md -translate-x-1/2 -translate-y-1/2 rounded-lg bg-white p-6 shadow-xl dark:bg-gray-800">
      <h3 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Nueva Atención</h3>
      <form id="atencionForm" class="space-y-4">
        <input type="hidden" id="pacienteId" />

        <!-- Selector de profesional -->
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">
            Profesional
          </label>
          <select
            id="profesional"
            required
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-300"
          >
            <option value="">Seleccione un profesional</option>
          </select>
        </div>

        <!-- Campo de fecha -->
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">
            Fecha y Hora
          </label>
          <input
            type="datetime-local"
            id="fecha"
            required
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-300"
          />
        </div>

        <!-- Campo de notas -->
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">
            Notas
          </label>
          <textarea
            id="notaDelDia"
            required
            rows="4"
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-300"
          ></textarea>
        </div>

        <!-- Botones del modal -->
        <div class="flex justify-end space-x-2">
          <button
            type="button"
            id="cancelarBtnA"
            class="rounded-md border border-gray-300 bg-white px-4 py-2 text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600"
          >
            Cancelar
          </button>
          <button
            type="submit"
            class="rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600"
          >
            Guardar
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal Editar Atención -->
  <div
    id="editarAtencionModal"
    class="fixed left-0 top-0 z-50 hidden h-full w-full bg-black bg-opacity-50"
  >
    <div class="absolute left-1/2 top-1/2 w-full max-w-md -translate-x-1/2 -translate-y-1/2 rounded-lg bg-white p-6 shadow-xl dark:bg-gray-800">
      <h3 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Editar Atención</h3>
      <form id="editarAtencionForm" class="space-y-4">
        <input type="hidden" id="editPacienteId" />
        <input type="hidden" id="editFechaOriginal" />
        
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">
            Profesional
          </label>
          <select
            id="editProfesional"
            required
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-300"
          >
          </select>
        </div>

        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">
            Fecha y Hora
          </label>
          <input
            type="datetime-local"
            id="editFecha"
            required
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-300"
          />
        </div>

        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">
            Notas
          </label>
          <textarea
            id="editNotaDelDia"
            required
            rows="4"
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-300"
          ></textarea>
        </div>

        <div class="flex justify-end space-x-2">
          <button
            type="button"
            id="cancelarEditarBtnA"
            class="rounded-md border border-gray-300 bg-white px-4 py-2 text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600"
          >
            Cancelar
          </button>
          <button
            type="submit"
            class="rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600"
          >
            Actualizar
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Notificación -->
  <div id="notification" class="hidden fixed top-4 right-4 p-4 rounded-md shadow-lg"></div>
</div>

<script define:vars={{ dni }}>
const BASE_URL = "https://odontoback-production.up.railway.app/api";

// Función para formatear fechas
function formatFecha(fechaStr) {
  const fecha = new Date(fechaStr);
  fecha.setHours(fecha.getHours() + 3);
  return fecha.toLocaleString('es-AR', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit'
  });
}

// Función para mostrar notificaciones
function showNotification(message, type = 'success') {
  const notification = document.getElementById('notification');
  notification.textContent = message;
  notification.className = `fixed top-4 right-4 p-4 rounded-md shadow-lg ${
    type === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
  }`;
  
  notification.classList.remove('hidden');
  setTimeout(() => {
    notification.classList.add('hidden');
  }, 3000);
}

// Función para cargar datos iniciales
async function cargarDatosIniciales() {
  try {
    // Cargar datos del paciente
    const pacienteResponse = await fetch(`${BASE_URL}/paciente/findByDni/${dni}`);
    if (!pacienteResponse.ok) {
      throw new Error('Error al cargar datos del paciente');
    }
    
    const { paciente } = await pacienteResponse.json();
    if (!paciente || !paciente.dni) {
      throw new Error('No se encontraron datos válidos del paciente');
    }

    const pacienteId = paciente._id || paciente.id;
    document.getElementById('pacienteId').value = pacienteId;

    // Cargar lista de médicos
    const medicosResponse = await fetch(`${BASE_URL}/medico`);
    if (!medicosResponse.ok) {
      throw new Error('Error al cargar lista de médicos');
    }
    
    const { medicos } = await medicosResponse.json();

    // Poblar selectores de médicos
    const selectMedicos = document.getElementById('profesional');
    const selectMedicosEdit = document.getElementById('editProfesional');
    
    if (!selectMedicos || !selectMedicosEdit) {
      throw new Error('Error en la interfaz de usuario');
    }

    const medicosOptions = ['<option value="">Seleccione un profesional</option>']
      .concat(medicos.map(medico => 
        `<option value="${medico.nombre}">${medico.nombre}</option>`
      ));
    
    selectMedicos.innerHTML = medicosOptions.join('');
    selectMedicosEdit.innerHTML = medicosOptions.join('');

    // Cargar tabla de atenciones
    await cargarAtenciones(pacienteId);
  } catch (error) {
    console.error('Error en cargarDatosIniciales:', error);
    showNotification(error.message, 'error');
  }
}

// Función para cargar atenciones
async function cargarAtenciones(pacienteId) {
  try {
    const response = await fetch(`${BASE_URL}/atenciones/todas/${pacienteId}`);
    if (!response.ok) {
      throw new Error('Error al cargar atenciones');
    }
    
    const atenciones = await response.json();
    const tableBody = document.getElementById('atencionesTableBody');
    if (!tableBody) {
      throw new Error('Error en la interfaz de usuario');
    }

    // Ordenar atenciones
    const atencionesOrdenadas = atenciones.sort((a, b) => new Date(a.fecha) - new Date(b.fecha));

    tableBody.innerHTML = atencionesOrdenadas.map(atencion => `
      <tr class="bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700">
        <td class="px-4 py-2 text-gray-900 dark:text-gray-300">${formatFecha(atencion.fecha)}</td>
        <td class="px-4 py-2 text-gray-900 dark:text-gray-300">${atencion.profesional}</td>
        <td class="px-4 py-2 text-gray-900 dark:text-gray-300">${atencion.notaDelDia}</td>
        <td class="px-4 py-2 text-right">
          <div class="flex justify-end space-x-2">
            <button 
              onclick="editarAtencionHandler('${pacienteId}', '${atencion.fecha}')"
              class="p-2 text-blue-600 hover:text-blue-700 dark:text-blue-500 dark:hover:text-blue-400"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" 
                   stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
              </svg>
            </button>
            <button 
              onclick="eliminarAtencionHandler('${pacienteId}', '${atencion.fecha}')"
              class="p-2 text-red-600 hover:text-red-700 dark:text-red-500 dark:hover:text-red-400"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" 
                   stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 6h18"/>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>
                <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
              </svg>
            </button>
          </div>
        </td>
      </tr>
    `).join('');
  } catch (error) {
    console.error('Error en cargarAtenciones:', error);
    showNotification(error.message, 'error');
  }
}

// Event Handlers
window.editarAtencionHandler = async function(pacienteId, fecha) {
  try {
    const response = await fetch(`${BASE_URL}/atenciones/unica/${pacienteId}/fecha/${fecha}`);
    if (!response.ok) {
      throw new Error('Error al cargar la atención');
    }
    
    const atencion = await response.json();
    
    // Rellenar el formulario con los datos existentes
    document.getElementById('editPacienteId').value = pacienteId;
    document.getElementById('editFechaOriginal').value = fecha;
    document.getElementById('editProfesional').value = atencion.profesional;
    document.getElementById('editFecha').value = new Date(atencion.fecha).toISOString().slice(0, 16);
    document.getElementById('editNotaDelDia').value = atencion.notaDelDia;
    
    // Mostrar el modal
    document.getElementById('editarAtencionModal').classList.remove('hidden');
  } catch (error) {
    console.error('Error en editarAtencionHandler:', error);
    showNotification(error.message, 'error');
  }
};

window.eliminarAtencionHandler = async function(pacienteId, fecha) {
  if (!confirm('¿Está seguro de eliminar esta atención?')) return;
  
  try {
    const response = await fetch(`${BASE_URL}/atenciones/delete-atencion/${pacienteId}/fecha/${fecha}`, {
      method: 'DELETE'
    });

    if (!response.ok) {
      throw new Error('Error al eliminar la atención');
    }
    
    showNotification('Atención eliminada exitosamente');
    await cargarAtenciones(pacienteId);
  } catch (error) {
    console.error('Error en eliminarAtencionHandler:', error);
    showNotification(error.message, 'error');
  }
};

// Inicialización y eventos del DOM
document.addEventListener('DOMContentLoaded', () => {
  // Vincular eventos de manera más explícita
  document.getElementById('cancelarBtnA').addEventListener('click', (e) => {
    document.getElementById('atencionModal').classList.add('hidden');
    document.getElementById('atencionForm').reset();
  });

  document.getElementById('cancelarEditarBtnA').addEventListener('click', (e) => {
    document.getElementById('editarAtencionModal').classList.add('hidden');
    document.getElementById('editarAtencionForm').reset();
  });

  // Cerrar modales al hacer clic fuera
  window.addEventListener('click', (e) => {
    const modal = document.getElementById('atencionModal');
    const editModal = document.getElementById('editarAtencionModal');
    
    if (e.target === modal) {
      modal.classList.add('hidden');
      document.getElementById('atencionForm').reset();
    }
    
    if (e.target === editModal) {
      editModal.classList.add('hidden');
      document.getElementById('editarAtencionForm').reset();
    }
  });

  // Cerrar modales con Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const modal = document.getElementById('atencionModal');
      const editModal = document.getElementById('editarAtencionModal');
      
      modal.classList.add('hidden');
      editModal.classList.add('hidden');
      
      document.getElementById('atencionForm').reset();
      document.getElementById('editarAtencionForm').reset();
    }
  });

  const nuevaAtencionBtn = document.getElementById('nuevaAtencionBtn');
  if (nuevaAtencionBtn) {
    nuevaAtencionBtn.addEventListener('click', () => {
      document.getElementById('atencionModal').classList.remove('hidden');
    });
  }

  // Manejo del formulario de nueva atención
  const form = document.getElementById('atencionForm');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitButton = form.querySelector('button[type="submit"]');
    submitButton.disabled = true;
    submitButton.textContent = 'Guardando...';

    try {
      const formData = {
        paciente: document.getElementById('pacienteId').value,
        profesional: document.getElementById('profesional').value,
        fecha: document.getElementById('fecha').value,
        notaDelDia: document.getElementById('notaDelDia').value
      };

      const response = await fetch(`${BASE_URL}/atenciones/create`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(formData)
      });

      if (!response.ok) {
        throw new Error('Error al crear la atención');
      }

      showNotification('Atención creada exitosamente');
      document.getElementById('atencionModal').classList.add('hidden');
      form.reset();
      await cargarAtenciones(formData.paciente);
    } catch (error) {
      console.error('Error en submit de nueva atención:', error);
      showNotification(error.message, 'error');
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Guardar';
    }
  });

  // Manejo del formulario de edición
  const editarForm = document.getElementById('editarAtencionForm');
  editarForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitButton = editarForm.querySelector('button[type="submit"]');
    submitButton.disabled = true;
    submitButton.textContent = 'Actualizando...';

    try {
      const pacienteId = document.getElementById('editPacienteId').value;
      const fechaOriginal = document.getElementById('editFechaOriginal').value;
      
      const formData = {
        profesional: document.getElementById('editProfesional').value,
        fecha: document.getElementById('editFecha').value,
        notaDelDia: document.getElementById('editNotaDelDia').value
      };

      const response = await fetch(`${BASE_URL}/atenciones/edit-atencion/${pacienteId}/fecha/${fechaOriginal}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(formData)
      });

      if (!response.ok) {
        throw new Error('Error al actualizar la atención');
      }

      showNotification('Atención actualizada exitosamente');
      document.getElementById('editarAtencionModal').classList.add('hidden');
      editarForm.reset();
      await cargarAtenciones(pacienteId);
    } catch (error) {
      console.error('Error en submit de edición:', error);
      showNotification(error.message, 'error');
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Actualizar';
    }
  });

  // Inicializar datos
  cargarDatosIniciales();
});

// Evento para el sistema de enrutamiento de Astro
document.addEventListener('astro:page-load', () => {
  cargarDatosIniciales();
});
</script>