---
import ColapsoButton from './ColapsoButton.astro';

interface Props {
  dni: string;
}

const { dni } = Astro.props;
---

<!-- Estructura principal -->
<div class="space-y-6">
  <!-- Header con botones principales -->
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-semibold text-slate-800 dark:text-slate-100 sm:text-xl">
      Prestaciones
    </h2>
    <div class="flex space-x-3">
      <button
        id="historialBtn"
        class="rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600"
      >
        Historial de Prestaciones
      </button>
      <button
        id="agregarPagoBtn"
        class="rounded-md bg-green-600 px-4 py-2 text-white hover:bg-green-700 dark:bg-green-500 dark:hover:bg-green-600"
      >
        Agregar Pago
      </button>
      <button
        id="nuevaPrestacionBtn"
        class="rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600"
      >
        Nueva Prestación
      </button>
    </div>

  </div>

  <!-- Tabla principal de prestaciones -->
  <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700">
    <table class="w-full table-auto border-collapse">
      <thead>
        <tr class="border-b border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-800">
          <th class="px-4 py-2 text-left text-gray-700 dark:text-gray-200">Tratamiento</th>
          <th class="px-4 py-2 text-right text-gray-700 dark:text-gray-200">Precio Total</th>
          <th class="px-4 py-2 text-right text-gray-700 dark:text-gray-200">Total Pagado</th>
          <th class="px-4 py-2 text-right text-gray-700 dark:text-gray-200">Saldo Pendiente</th>
          <th class="px-4 py-2 text-right text-gray-700 dark:text-gray-200">Últimos Pagos</th>
          <th class="px-4 py-2 text-right text-gray-700 dark:text-gray-200">Acciones</th>
        </tr>
      </thead>
      <tbody id="prestacionesTableBody" class="divide-y divide-gray-200 dark:divide-gray-700"></tbody>
      <tfoot>
        <tr class="border-t-2 border-gray-200 font-semibold dark:border-gray-700">
          <td class="px-4 py-2 text-right text-gray-700 dark:text-gray-200" colspan="5">Total Adeudado:</td>
          <td id="totalAdeudado" class="px-4 py-2 text-right"></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <!-- Modal Historial -->
  <div
    id="historialModal"
    class="fixed left-0 top-0 z-50 hidden h-full w-full overflow-auto bg-black bg-opacity-50"
  >
    <div class="absolute left-1/2 top-10 w-full max-w-5xl -translate-x-1/2 rounded-lg bg-white p-6 shadow-xl dark:bg-gray-800">
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Historial de Prestaciones</h3>
        <button
          id="cerrarHistorialBtn"
          class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <div class="overflow-x-auto">
        <table class="w-full table-auto border-collapse">
          <thead>
            <tr class="border-b border-gray-200 bg-gray-50 text-sm dark:border-gray-700 dark:bg-gray-800">
              <th class="px-4 py-2 text-left text-gray-700 dark:text-gray-200">Fecha</th>
              <th class="px-4 py-2 text-left text-gray-700 dark:text-gray-200">Tipo</th>
              <th class="px-4 py-2 text-left text-gray-700 dark:text-gray-200">Tratamiento</th>
              <th class="px-4 py-2 text-right text-gray-700 dark:text-gray-200">Monto</th>
              <th class="px-4 py-2 text-left text-gray-700 dark:text-gray-200">Usuario</th>
              <th class="px-4 py-2 text-left text-gray-700 dark:text-gray-200">Detalles</th>
            </tr>
          </thead>
          <tbody id="historialTableBody" class="divide-y divide-gray-200 text-sm dark:divide-gray-700">
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Modal Nueva Prestación -->
  <div
    id="prestacionModal"
    class="fixed left-0 top-0 z-50 hidden h-full w-full bg-black bg-opacity-50"
  >
    <div class="absolute left-1/2 top-1/2 w-full max-w-md -translate-x-1/2 -translate-y-1/2 rounded-lg bg-white p-6 shadow-xl dark:bg-gray-800">
      <h3 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Nueva Prestación</h3>
      <form id="prestacionForm" class="space-y-4">
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">Tratamiento</label>
          <select
            name="tratamiento"
            required
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-blue-500"
          >
            <option value="">Seleccione un tratamiento</option>
          </select>
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">Precio</label>
          <input
            type="number"
            name="precio"
            required
            min="0"
            step="0.01"
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-blue-500"
          />
        </div>
        <div class="flex justify-end space-x-2">
          <button
            type="button"
            id="cancelarBtn"
            class="rounded-md border border-gray-300 bg-white px-4 py-2 text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600"
          >
            Cancelar
          </button>
          <button
            type="submit"
            class="rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600"
          >
            Guardar
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal Editar Prestación -->
  <div
    id="editarPrestacionModal"
    class="fixed left-0 top-0 z-50 hidden h-full w-full bg-black bg-opacity-50"
  >
    <div class="absolute left-1/2 top-1/2 w-full max-w-md -translate-x-1/2 -translate-y-1/2 rounded-lg bg-white p-6 shadow-xl dark:bg-gray-800">
      <h3 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Editar Prestación</h3>
      <form id="editarPrestacionForm" class="space-y-4">
        <input type="hidden" name="prestacionId" />
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">Tratamiento</label>
          <select
            name="tratamiento"
            required
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-blue-500"
          >
            <option value="">Seleccione un tratamiento</option>
          </select>
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">Precio</label>
          <input
            type="number"
            name="precio"
            required
            min="0"
            step="0.01"
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-blue-500"
          />
        </div>
        <div class="flex justify-end space-x-2">
          <button
            type="button"
            id="cancelarEditarBtn"
            class="rounded-md border border-gray-300 bg-white px-4 py-2 text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600"
          >
            Cancelar
          </button>
          <button
            type="submit"
            class="rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600"
          >
            Actualizar
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal Pago -->
  <div
    id="pagoModal"
    class="fixed left-0 top-0 z-50 hidden h-full w-full bg-black bg-opacity-50"
  >
    <div class="absolute left-1/2 top-1/2 w-full max-w-md -translate-x-1/2 -translate-y-1/2 rounded-lg bg-white p-6 shadow-xl dark:bg-gray-800">
      <h3 id="pagoModalTitle" class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Registrar Pago</h3>
      <form id="pagoForm" class="space-y-4">
        <input type="hidden" name="prestacionId" />
        <input type="hidden" name="pagoId" />
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">Prestación</label>
          <select
            name="prestacionSelect"
            required
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-blue-500"
          >
            <option value="">Seleccione una prestación</option>
          </select>
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">Monto del Pago</label>
          <input
            type="number"
            name="montoPago"
            required
            min="0"
            step="0.01"
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-blue-500"
          />
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">Fecha del Pago</label>
          <input
            type="datetime-local"
            name="fechaPago"
            required
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-blue-500"
          />
        </div>
        <div class="flex justify-end space-x-2">
          <button
            type="button"
            id="cancelarPagoBtn"
            class="rounded-md border border-gray-300 bg-white px-4 py-2 text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600"
          >
            Cancelar
          </button>
          <button
            type="submit"
            class="rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600"
          >
            Guardar
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script define:vars={{ dni }}>
  // ====================================
  // CONFIGURACIÓN
  // ====================================
  const BASE_URL = "https://odontoback-production.up.railway.app/api";
  
  // ====================================
  // FUNCIONES DE API
  // ====================================
  async function obtenerTratamientos() {
    try {
      const response = await fetch(`${BASE_URL}/tratamientos`);
      if (!response.ok) throw new Error('Error al obtener tratamientos');
      const data = await response.json();
      return Array.isArray(data) ? data : [];
    } catch (error) {
      console.error('Error al obtener tratamientos:', error);
      return [];
    }
  }
  
  async function obtenerPacientePorDni() {
  try {
    console.log('Buscando paciente con DNI:', dni);
    const response = await fetch(`${BASE_URL}/paciente/findByDni/${dni}`);
    if (!response.ok) throw new Error(`Error HTTP: ${response.status}`);
    const data = await response.json();
    console.log('Datos del paciente:', data);
    
    // Verificar si tenemos datos del paciente
    if (!data || !data.paciente) {
      throw new Error('No se encontraron datos del paciente');
    }

    // Asegurarnos de que tenemos el ID del paciente
    const pacienteId = data.paciente._id || data.paciente.id;
    if (!pacienteId) {
      throw new Error('El paciente no tiene un ID válido');
    }

    return {
      ...data.paciente,
      _id: pacienteId // Asegurarnos de que siempre usamos _id
    };
  } catch (error) {
    console.error('Error al obtener paciente:', error);
    throw error;
  }
}
  
async function obtenerPrestaciones(pacienteId) {
  try {
    if (!pacienteId) {
      throw new Error('ID de paciente no proporcionado');
    }
    
    console.log('Obteniendo prestaciones para pacienteId:', pacienteId);
    const response = await fetch(`${BASE_URL}/prestaciones/paciente/${pacienteId}`);
    
    if (!response.ok) {
      const errorData = await response.json();
      throw new Error(errorData.error || 'Error al obtener prestaciones');
    }
    
    const data = await response.json();
    console.log('Prestaciones obtenidas:', data);
    return Array.isArray(data) ? data : [];
  } catch (error) {
    console.error('Error en obtenerPrestaciones:', error);
    throw error;
  }
}
  
async function crearPrestacion(data) {
  try {
    // Asegurarnos de que estamos usando el campo correcto para el ID del paciente
    const prestacionData = {
      ...data,
      pacienteId: data.pacienteId // Debe ser el _id del paciente
    };

    const response = await fetch(`${BASE_URL}/prestaciones`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(prestacionData)
    });
    if (!response.ok) throw new Error('Error al crear la prestación');
    return await response.json();
  } catch (error) {
    console.error('Error al crear prestación:', error);
    throw error;
  }
}
  
  async function actualizarPrestacion(id, data) {
    try {
      const response = await fetch(`${BASE_URL}/prestaciones/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (!response.ok) throw new Error('Error al actualizar la prestación');
      return await response.json();
    } catch (error) {
      console.error('Error al actualizar prestación:', error);
      throw error;
    }
  }
  
  async function eliminarPrestacion(id) {
    try {
      const response = await fetch(`${BASE_URL}/prestaciones/${id}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ odontologoId: localStorage.getItem('userId') || 'Sistema' })
      });
      if (!response.ok) throw new Error('Error al eliminar la prestación');
    } catch (error) {
      console.error('Error al eliminar prestación:', error);
      throw error;
    }
  }
  
  async function registrarPago(prestacionId, data) {
    try {
      const response = await fetch(`${BASE_URL}/prestaciones/${prestacionId}/pagos`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (!response.ok) throw new Error('Error al registrar el pago');
      return await response.json();
    } catch (error) {
      console.error('Error al registrar pago:', error);
      throw error;
    }
  }
  
  async function editarPago(prestacionId, pagoId, data) {
    try {
      const response = await fetch(`${BASE_URL}/prestaciones/${prestacionId}/pagos/${pagoId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (!response.ok) throw new Error('Error al editar el pago');
      return await response.json();
    } catch (error) {
      console.error('Error al editar pago:', error);
      throw error;
    }
  }
  
  // ====================================
  // FUNCIONES DE UTILIDAD
  // ====================================
  function formatearMoneda(valor) {
    return new Intl.NumberFormat('es-AR', {
      style: 'currency',
      currency: 'ARS'
    }).format(valor);
  }
  
  function formatearFechaHora(fecha) {
    return new Date(fecha).toLocaleString('es-AR', {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit'
    });
  }
  
  function calcularTotalAdeudado(prestaciones) {
    return prestaciones.reduce((total, p) => {
      const totalPagos = (p.pagos || []).reduce((sum, pago) => 
        pago.eliminado ? sum : sum + pago.monto, 0
      );
      return total + (p.precio - totalPagos);
    }, 0);
  }
  
  function mostrarNotificacion(mensaje, tipo = 'success') {
    const notificacionExistente = document.querySelector('.notificacion');
    if (notificacionExistente) {
      notificacionExistente.remove();
    }
  
    const notificacion = document.createElement('div');
    notificacion.className = `notificacion fixed right-4 top-4 z-50 rounded-lg p-4 shadow-lg transition-opacity duration-300 ${
      tipo === 'success' ? 'bg-green-500 dark:bg-green-600' : 'bg-red-500 dark:bg-red-600'
    } text-white`;
    notificacion.textContent = mensaje;
  
    document.body.appendChild(notificacion);
  
    setTimeout(() => {
      notificacion.style.opacity = '0';
      setTimeout(() => notificacion.remove(), 300);
    }, 3000);
  }

// ====================================
// FUNCIONES DE CARGA DE DATOS
// ====================================
async function cargarTratamientos() {
  try {
    const tratamientos = await obtenerTratamientos();
    const selectElements = document.querySelectorAll('select[name="tratamiento"]');
    
    const optionsHTML = tratamientos.map(t => 
      `<option value="${t._id}" data-precio="${t.precio}">${t.nombre}</option>`
    ).join('');

    selectElements.forEach(select => {
      select.innerHTML = '<option value="">Seleccione un tratamiento</option>' + optionsHTML;
    });
  } catch (error) {
    console.error('Error al cargar tratamientos:', error);
    mostrarNotificacion('Error al cargar los tratamientos', 'error');
  }
}

async function cargarPrestaciones() {
  try {
    if (!dni) {
      throw new Error('DNI no proporcionado');
    }

    const paciente = await obtenerPacientePorDni();
    const prestaciones = await obtenerPrestaciones(paciente._id);
    renderizarPrestaciones(prestaciones);
  } catch (error) {
    console.error('Error al cargar prestaciones:', error);
    document.getElementById('prestacionesTableBody').innerHTML = `
      <tr>
        <td colspan="6" class="px-4 py-2 text-center text-red-600 dark:text-red-400">
          Error al cargar los datos: ${error.message}
        </td>
      </tr>
    `;
  }
}

// ====================================
// FUNCIONES DE RENDERIZADO
// ====================================
function generarHistorial(prestaciones) {
  const historial = [];
  
  prestaciones.forEach(prestacion => {
    // Registro de creación de prestación...
    historial.push({
      fecha: prestacion.createdAt,
      tipo: 'Creación',
      tratamiento: prestacion.tratamientoId?.nombre,
      monto: prestacion.precio,
      usuario: prestacion.creadoPor || 'Sistema',
      detalles: `Creación de prestación: ${prestacion.tratamientoId?.nombre}`
    });

    // Registro de pagos y sus modificaciones
    prestacion.pagos.forEach(pago => {
      // Registro del pago
      historial.push({
        fecha: pago.fecha,
        tipo: 'Pago',
        tratamiento: prestacion.tratamientoId?.nombre,
        monto: pago.monto,
        usuario: pago.odontologoId || 'Sistema',
        detalles: `Pago registrado para ${prestacion.tratamientoId?.nombre}`
      });

      // Si el pago fue editado
      if (pago.editadoPor) {
  historial.push({
    fecha: pago.fechaEdicion,
    tipo: 'Edición de Pago',
    tratamiento: prestacion.tratamientoId?.nombre,
    monto: pago.monto,
    usuario: pago.editadoPor,
    detalles: `Pago editado en ${prestacion.tratamientoId?.nombre}`
  });
}

      // Si el pago fue eliminado
      if (pago.eliminadoPor) {
  historial.push({
    fecha: pago.fechaEliminacion,
    tipo: 'Eliminación de Pago',
    tratamiento: prestacion.tratamientoId?.nombre,
    monto: pago.monto,
    usuario: pago.eliminadoPor,
    detalles: `Pago eliminado en ${prestacion.tratamientoId?.nombre}`
  });
}
    });

    // Otras modificaciones de la prestación...
  });

  return historial.sort((a, b) => new Date(b.fecha) - new Date(a.fecha));
}

function renderizarHistorial(historial) {
  const tbody = document.getElementById('historialTableBody');
  
  tbody.innerHTML = historial.map(item => `
    <tr class="bg-white hover:bg-gray-50 dark:bg-gray-800 dark:hover:bg-gray-700">
      <td class="px-4 py-2 text-gray-900 dark:text-gray-200">
        ${formatearFechaHora(item.fecha)}
      </td>
      <td class="px-4 py-2">
        <span class="rounded-full px-2 py-1 text-xs font-semibold ${
          item.tipo === 'Pago' 
            ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200'
            : item.tipo === 'Modificación'
            ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200'
            : item.tipo === 'Eliminación'
            ? 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200'
            : 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200'
        }">
          ${item.tipo}
        </span>
      </td>
      <td class="px-4 py-2 text-gray-900 dark:text-gray-200">
        ${item.tratamiento || 'N/A'}
      </td>
      <td class="px-4 py-2 text-right text-gray-900 dark:text-gray-200">
        ${formatearMoneda(item.monto)}
      </td>
      <td class="px-4 py-2 text-gray-900 dark:text-gray-200">
        ${item.usuario}
      </td>
      <td class="px-4 py-2 text-gray-600 dark:text-gray-400">
        ${item.detalles}
      </td>
    </tr>
  `).join('');
}

function renderizarPagos(pagos, prestacionId) {
  return pagos
    .filter(pago => !pago.eliminado)
    .sort((a, b) => new Date(b.fecha) - new Date(a.fecha))
    .slice(0, 2)
    .map(pago => `
      <div class="mb-1 rounded bg-green-50 p-2 text-sm dark:bg-green-900/20">
        <div class="flex items-center justify-between">
          <span class="text-gray-600 dark:text-gray-300">
            ${formatearFechaHora(pago.fecha)} - ${formatearMoneda(pago.monto)}
          </span>
          <div class="flex space-x-2">
            <button
              onclick="editarPagoHandler('${prestacionId}', '${pago._id}')"
              class="text-blue-600 hover:text-blue-700 dark:text-blue-400"
              title="Editar pago"
            >
