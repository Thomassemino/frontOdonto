window.editarPrestacionHandler = async function(id) {
  try {
    const paciente = await obtenerPacientePorDni();
    const prestaciones = await obtenerPrestaciones(paciente._id);
    const prestacion = prestaciones.find(p => p._id === id);

    if (!prestacion) throw new Error('No se encontró la prestación');

    const modal = document.getElementById('editarPrestacionModal');
    const form = document.getElementById('editarPrestacionForm');
    
    form.querySelector('input[name="prestacionId"]').value = prestacion._id;
    form.querySelector('select[name="tratamiento"]').value = prestacion.tratamientoId._id;
    form.querySelector('input[name="precio"]').value = prestacion.precio;

    modal.classList.remove('hidden');
  } catch (error) {
    console.error('Error al abrir el modal de edición:', error);
    mostrarNotificacion('Error al cargar los datos de la prestación', 'error');
  }
};

window.eliminarPrestacionHandler = async function(id) {
  if (confirm('¿Está seguro de eliminar esta prestación?')) {
    try {
      await eliminarPrestacion(id);
      mostrarNotificacion('Prestación eliminada correctamente', 'success');
      await cargarPrestaciones();
    } catch (error) {
      console.error('Error al eliminar prestación:', error);
      mostrarNotificacion('Error al eliminar la prestación', 'error');
    }
  }
};

// Hacer funciones disponibles globalmente
window.cargarTratamientos = cargarTratamientos;
window.cargarPrestaciones = cargarPrestaciones;

// ====================================
// HANDLERS DE PAGOS
// ====================================
window.editarPagoHandler = async function(prestacionId, pagoId) {
  try {
    const modal = document.getElementById('pagoModal');
    const form = document.getElementById('pagoForm');
    const titulo = document.getElementById('pagoModalTitle');
    
    const paciente = await obtenerPacientePorDni();
    const prestaciones = await obtenerPrestaciones(paciente._id);
    const prestacion = prestaciones.find(p => p._id === prestacionId);
    const pago = prestacion.pagos.find(p => p._id === pagoId);

    titulo.textContent = 'Editar Pago';
    form.querySelector('input[name="prestacionId"]').value = prestacionId;
    form.querySelector('input[name="pagoId"]').value = pagoId;
    form.querySelector('select[name="prestacionSelect"]').value = prestacionId;
    form.querySelector('input[name="montoPago"]').value = pago.monto;
    
    const fecha = new Date(pago.fecha);
    fecha.setMinutes(fecha.getMinutes() - fecha.getTimezoneOffset());
    form.querySelector('input[name="fechaPago"]').value = fecha.toISOString().slice(0, 16);
    
    modal.classList.remove('hidden');
  } catch (error) {
    console.error('Error al cargar datos del pago:', error);
    mostrarNotificacion('Error al cargar los datos del pago', 'error');
  }
};

window.eliminarPagoHandler = async function(prestacionId, pagoId) {
  if (confirm('¿Está seguro de eliminar este pago?')) {
    try {
      const response = await fetch(`${BASE_URL}/prestaciones/${prestacionId}/pagos/${pagoId}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          eliminadoPor: localStorage.getItem('userId') || 'Sistema',
          fechaEliminacion: new Date()
        })
      });

      if (!response.ok) throw new Error('Error al eliminar el pago');

      await cargarPrestaciones();
      mostrarNotificacion('Pago eliminado correctamente', 'success');
    } catch (error) {
      console.error('Error al eliminar pago:', error);
      mostrarNotificacion('Error al eliminar el pago', 'error');
    }
  }
};

// ====================================
// INICIALIZACIÓN Y MANEJO DE EVENTOS
// ====================================
document.addEventListener('DOMContentLoaded', async () => {
  try {
    const prestacionModal = document.getElementById('prestacionModal');
    const editarModal = document.getElementById('editarPrestacionModal');
    const pagoModal = document.getElementById('pagoModal');
    const historialModal = document.getElementById('historialModal');
    const prestacionForm = document.getElementById('prestacionForm');
    const editarForm = document.getElementById('editarPrestacionForm');
    const pagoForm = document.getElementById('pagoForm');

    // Manejador del historial
    document.getElementById('historialBtn').addEventListener('click', async () => {
      try {
        const paciente = await obtenerPacientePorDni();
        const prestaciones = await obtenerPrestaciones(paciente._id);
        const historial = generarHistorial(prestaciones);
        renderizarHistorial(historial);
        historialModal.classList.remove('hidden');
      } catch (error) {
        console.error('Error al cargar historial:', error);
        mostrarNotificacion('Error al cargar el historial', 'error');
      }
    });

    document.getElementById('cerrarHistorialBtn').addEventListener('click', () => {
      historialModal.classList.add('hidden');
    });

    // Event listeners para tratamientos
    document.querySelectorAll('select[name="tratamiento"]').forEach(select => {
      select.addEventListener('change', (e) => {
        const selectedOption = e.target.options[e.target.selectedIndex];
        const precio = selectedOption.dataset.precio;
        if (precio) {
          const form = e.target.closest('form');
          form.querySelector('input[name="precio"]').value = precio;
        }
      });
    });

    // Manejadores de botones principales
    document.getElementById('nuevaPrestacionBtn').addEventListener('click', () => {
      prestacionForm.reset();
      prestacionModal.classList.remove('hidden');
    });

    document.getElementById('agregarPagoBtn').addEventListener('click', () => {
      const form = document.getElementById('pagoForm');
      const titulo = document.getElementById('pagoModalTitle');
      
      form.reset();
      titulo.textContent = 'Registrar Pago';
      form.querySelector('input[name="pagoId"]').value = '';
      
      // Establecer fecha y hora actual
      const now = new Date();
      now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
      form.querySelector('input[name="fechaPago"]').value = now.toISOString().slice(0, 16);
      
      pagoModal.classList.remove('hidden');
    });

    // Formulario de nueva prestación
    prestacionForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitButton = prestacionForm.querySelector('button[type="submit"]');
      submitButton.disabled = true;
      const originalText = submitButton.textContent;
      submitButton.textContent = 'Guardando...';

      try {
        const paciente = await obtenerPacientePorDni();
        const formData = new FormData(prestacionForm);
        
        const prestacionData = {
          pacienteId: paciente.id,
          tratamientoId: formData.get('tratamiento'),
          precio: parseFloat(formData.get('precio')),
          pagos: [],
          creadoPor: localStorage.getItem('userId') || 'Sistema'
        };

        await crearPrestacion(prestacionData);
        await cargarPrestaciones();
        prestacionModal.classList.add('hidden');
        prestacionForm.reset();
        mostrarNotificacion('Prestación creada exitosamente', 'success');
      } catch (error) {
        console.error('Error al crear prestación:', error);
        mostrarNotificacion('Error al crear la prestación', 'error');
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = originalText;
      }
    });

    // Formulario de edición de prestación
    editarForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitButton = editarForm.querySelector('button[type="submit"]');
      submitButton.disabled = true;
      const originalText = submitButton.textContent;
      submitButton.textContent = 'Actualizando...';

      try {
        const formData = new FormData(editarForm);
        const prestacionId = formData.get('prestacionId');
        const prestacionData = {
          tratamientoId: formData.get('tratamiento'),
          precio: parseFloat(formData.get('precio')),
          modificadoPor: localStorage.getItem('userId') || 'Sistema',
          fechaModificacion: new Date()
        };

        await actualizarPrestacion(prestacionId, prestacionData);
        await cargarPrestaciones();
        editarModal.classList.add('hidden');
        editarForm.reset();
        mostrarNotificacion('Prestación actualizada exitosamente', 'success');
      } catch (error) {
        console.error('Error al actualizar prestación:', error);
        mostrarNotificacion('Error al actualizar la prestación', 'error');
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = originalText;
      }
    });

    // Formulario de pago
    pagoForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  const submitButton = pagoForm.querySelector('button[type="submit"]');
  submitButton.disabled = true;
  const originalText = submitButton.textContent;
  submitButton.textContent = 'Guardando...';

  try {
    const formData = new FormData(pagoForm);
    const prestacionId = formData.get('prestacionSelect');
    const pagoId = formData.get('pagoId');
    
    const pagoData = {
      monto: parseFloat(formData.get('montoPago')),
      fecha: formData.get('fechaPago'),
      odontologoId: localStorage.getItem('userId') || 'Sistema'
    };

    if (pagoId) {
      // Si estamos editando un pago existente
      const response = await fetch(`${BASE_URL}/prestaciones/${prestacionId}/pagos/${pagoId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...pagoData,
          editadoPor: localStorage.getItem('userId'),
          fechaEdicion: new Date()
        })
      });

      if (!response.ok) throw new Error('Error al editar el pago');
    } else {
      // Si estamos creando un nuevo pago
      const response = await fetch(`${BASE_URL}/prestaciones/${prestacionId}/pagos`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(pagoData)
      });

      if (!response.ok) throw new Error('Error al registrar el pago');
    }

    await cargarPrestaciones();
    pagoModal.classList.add('hidden');
    pagoForm.reset();
    mostrarNotificacion(
      `Pago ${pagoId ? 'actualizado' : 'registrado'} exitosamente`, 
      'success'
    );
  } catch (error) {
    console.error('Error al procesar pago:', error);
    mostrarNotificacion('Error al procesar el pago', 'error');
  } finally {
    submitButton.disabled = false;
    submitButton.textContent = originalText;
  }
});

// Manejadores para cerrar modales
document.getElementById('cancelarBtn').addEventListener('click', () => {
      prestacionModal.classList.add('hidden');
      prestacionForm.reset();
    });

    document.getElementById('cancelarEditarBtn').addEventListener('click', () => {
      editarModal.classList.add('hidden');
      editarForm.reset();
    });

    document.getElementById('cancelarPagoBtn').addEventListener('click', () => {
      pagoModal.classList.add('hidden');
      pagoForm.reset();
    });

    // Cerrar modales al hacer clic fuera o con Escape
    const modales = [
      { modal: prestacionModal, form: prestacionForm },
      { modal: editarModal, form: editarForm },
      { modal: pagoModal, form: pagoForm },
      { modal: historialModal }
    ];

    window.addEventListener('click', (e) => {
      modales.forEach(({ modal, form }) => {
        if (e.target === modal) {
          modal.classList.add('hidden');
          if (form) form.reset();
        }
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        modales.forEach(({ modal, form }) => {
          modal.classList.add('hidden');
          if (form) form.reset();
        });
      }
    });

    // Cargar datos iniciales
    await Promise.all([
      cargarTratamientos(),
      cargarPrestaciones()
    ]);

  } catch (error) {
    console.error('Error en la inicialización:', error);
    mostrarNotificacion('Error al inicializar el componente', 'error');
  }
});

// Manejar recarga de página en Astro
document.addEventListener('astro:page-load', async () => {
  try {
    await Promise.all([
      cargarTratamientos(),
      cargarPrestaciones()
    ]);
  } catch (error) {
    console.error('Error al recargar datos:', error);
    mostrarNotificacion('Error al recargar los datos', 'error');
  }
});
</script>