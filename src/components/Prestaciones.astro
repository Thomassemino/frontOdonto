    `).join('');
}

function renderizarPrestaciones(prestaciones) {
  const tbody = document.getElementById('prestacionesTableBody');
  const pagoSelect = document.querySelector('select[name="prestacionSelect"]');
  
  // Actualizar el select de prestaciones
  pagoSelect.innerHTML = '<option value="">Seleccione una prestación</option>' + 
    prestaciones
      .filter(p => !p.eliminado)
      .map(p => `
        <option value="${p._id}">${p.tratamientoId?.nombre || 'Sin tratamiento'} - ${formatearMoneda(p.precio)}</option>
      `).join('');

  tbody.innerHTML = prestaciones
    .filter(p => !p.eliminado)
    .map(p => {
      const totalPagado = (p.pagos || [])
        .filter(pago => !pago.eliminado)
        .reduce((sum, pago) => sum + pago.monto, 0);
      const saldoPendiente = p.precio - totalPagado;
    
      // Mostrar solo los últimos 2 pagos activos
      const ultimosPagos = (p.pagos || [])
  .filter(pago => !pago.eliminado)
  .sort((a, b) => new Date(b.fecha) - new Date(a.fecha))
  .slice(0, 2)
  .map(pago => `
    <div class="mb-1 rounded bg-green-50 p-1 text-sm dark:bg-green-900/20">
      <div class="flex items-center justify-between">
        <span class="text-gray-600 dark:text-gray-300">
          ${formatearFechaHora(pago.fecha)} - ${formatearMoneda(pago.monto)}
        </span>
        <div class="flex space-x-2">
          <button
            onclick="editarPagoHandler('${prestacion._id}', '${pago._id}')"
            class="text-blue-600 hover:text-blue-700 dark:text-blue-400"
            title="Editar pago"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" 
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
          </button>
          <button
            onclick="eliminarPagoHandler('${prestacion._id}', '${pago._id}')"
            class="text-red-600 hover:text-red-700 dark:text-red-400"
            title="Eliminar pago"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" 
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 6h18"/>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>
              <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
            </svg>
          </button>
        </div>
      </div>
      <div class="text-xs text-gray-500 dark:text-gray-400">
        Por: ${pago.odontologoId || 'Sistema'}
        ${pago.editadoPor ? ` - Editado por: ${pago.editadoPor}` : ''}
      </div>
    </div>
  `).join('');
  
  const total = calcularTotalAdeudado(prestaciones);
  const totalElement = document.getElementById('totalAdeudado');
  totalElement.textContent = formatearMoneda(total);
  totalElement.className = `px-4 py-2 text-right ${total < 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400'}`;
}

