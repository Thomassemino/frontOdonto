---
interface Props {
  dni: string;
}

const { dni } = Astro.props;
console.log('DNI recibido en el componente:', dni);
---

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-semibold text-slate-800 dark:text-slate-100 sm:text-xl">
      Prestaciones
    </h2>
    <button
      id="nuevaPrestacionBtn"
      class="rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600"
    >
      Nueva Prestación
    </button>
  </div>

  <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700">
    <table class="w-full table-auto border-collapse">
      <thead>
        <tr class="border-b border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-800">
          <th class="px-4 py-2 text-left text-gray-700 dark:text-gray-200">Descripción</th>
          <th class="px-4 py-2 text-right text-gray-700 dark:text-gray-200">Precio</th>
          <th class="px-4 py-2 text-right text-gray-700 dark:text-gray-200">Pagos Realizados</th>
          <th class="px-4 py-2 text-right text-gray-700 dark:text-gray-200">Acciones</th>
        </tr>
      </thead>
      <tbody id="prestacionesTableBody" class="divide-y divide-gray-200 dark:divide-gray-700"></tbody>
      <tfoot>
        <tr class="border-t-2 border-gray-200 font-semibold dark:border-gray-700">
          <td class="px-4 py-2 text-right text-gray-700 dark:text-gray-200" colspan="3">Total Adeudado:</td>
          <td id="totalAdeudado" class="px-4 py-2 text-right"></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <!-- Modal Nueva Prestación -->
  <div
    id="prestacionModal"
    class="fixed left-0 top-0 z-50 hidden h-full w-full bg-black bg-opacity-50"
  >
    <div class="absolute left-1/2 top-1/2 w-full max-w-md -translate-x-1/2 -translate-y-1/2 rounded-lg bg-white p-6 shadow-xl dark:bg-gray-800">
      <h3 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Nueva Prestación</h3>
      <form id="prestacionForm" class="space-y-4">
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">Tratamiento</label>
          <select
            name="tratamiento"
            required
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-blue-500"
          >
            <option value="">Seleccione un tratamiento</option>
          </select>
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">Precio</label>
          <input
            type="number"
            name="precio"
            required
            min="0"
            step="0.01"
            max="999999999999"
            maxlength="12"
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-blue-500"
          />
        </div>
        <div class="flex justify-end space-x-2">
          <button
            type="button"
            id="cancelarBtn"
            class="rounded-md border border-gray-300 bg-white px-4 py-2 text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600"
          >
            Cancelar
          </button>
          <button
            type="submit"
            class="rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600"
          >
            Guardar
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal Editar Prestación -->
  <div
    id="editarPrestacionModal"
    class="fixed left-0 top-0 z-50 hidden h-full w-full bg-black bg-opacity-50"
  >
    <div class="absolute left-1/2 top-1/2 w-full max-w-md -translate-x-1/2 -translate-y-1/2 rounded-lg bg-white p-6 shadow-xl dark:bg-gray-800">
      <h3 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Editar Prestación</h3>
      <form id="editarPrestacionForm" class="space-y-4">
        <input type="hidden" name="prestacionId" />
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">Tratamiento</label>
          <select
            name="tratamiento"
            required
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-blue-500"
          >
            <option value="">Seleccione un tratamiento</option>
          </select>
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">Precio</label>
          <input
            type="number"
            name="precio"
            required
            min="0"
            step="0.01"
            max="999999999999"
            maxlength="12"
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-blue-500"
          />
        </div>
        <div class="flex justify-end space-x-2">
          <button
            type="button"
            id="cancelarEditarBtn"
            class="rounded-md border border-gray-300 bg-white px-4 py-2 text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600"
          >
            Cancelar
          </button>
          <button
            type="submit"
            class="rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600"
          >
            Actualizar
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal Registrar Pago -->
  <div
    id="pagoModal"
    class="fixed left-0 top-0 z-50 hidden h-full w-full bg-black bg-opacity-50"
  >
    <div class="absolute left-1/2 top-1/2 w-full max-w-md -translate-x-1/2 -translate-y-1/2 rounded-lg bg-white p-6 shadow-xl dark:bg-gray-800">
      <h3 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Registrar Pago</h3>
      <form id="pagoForm" class="space-y-4">
        <input type="hidden" name="prestacionId" />
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">Monto del Pago</label>
          <input
            type="number"
            name="montoPago"
            required
            min="0"
            step="0.01"
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-blue-500"
          />
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200">Fecha del Pago</label>
          <input
            type="date"
            name="fechaPago"
            required
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-blue-500"
          />
        </div>
        <div class="flex justify-end space-x-2">
          <button
            type="button"
            id="cancelarPagoBtn"
            class="rounded-md border border-gray-300 bg-white px-4 py-2 text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600"
          >
            Cancelar
          </button>
          <button
            type="submit"
            class="rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600"
          >
            Registrar Pago
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script define:vars={{ dni }}>
const BASE_URL = "https://odontoback-production.up.railway.app/api";

async function obtenerTratamientos() {
  try {
    const response = await fetch(`${BASE_URL}/tratamientos`);
    if (!response.ok) {
      throw new Error('Error al obtener tratamientos');
    }
    const data = await response.json();
    return Array.isArray(data) ? data : [];
  } catch (error) {
    console.error('Error al obtener tratamientos:', error);
    return [];
  }
}

async function obtenerPacientePorDni() {
  try {
    console.log('Buscando paciente con DNI:', dni);
    const response = await fetch(`${BASE_URL}/paciente/findByDni/${dni}`);
    if (!response.ok) {
      throw new Error(`Error HTTP: ${response.status}`);
    }
    const data = await response.json();
    if (!data || !data.paciente) {
      throw new Error('No se encontraron datos del paciente');
    }
    return data.paciente;
  } catch (error) {
    console.error('Error al obtener paciente:', error);
    throw error;
  }
}

async function obtenerPrestaciones(pacienteId) {
  try {
    console.log('Obteniendo prestaciones para pacienteId:', pacienteId);
    const response = await fetch(`${BASE_URL}/prestaciones/paciente/${pacienteId}`);
    if (!response.ok) {
      const errorData = await response.json();
      throw new Error(errorData.error || 'Error al obtener prestaciones');
    }
    const data = await response.json();
    return Array.isArray(data) ? data : (data.prestaciones || []);
  } catch (error) {
    console.error('Error en obtenerPrestaciones:', error);
    return [];
  }
}

async function crearPrestacion(data) {
  try {
    const response = await fetch(`${BASE_URL}/prestaciones`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });

    if (!response.ok) {
      throw new Error('Error al crear la prestación');
    }

    return await response.json();
  } catch (error) {
    console.error('Error al crear prestación:', error);
    throw error;
  }
}

async function actualizarPrestacion(id, data) {
  try {
    const response = await fetch(`${BASE_URL}/prestaciones/${id}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });

    if (!response.ok) {
      throw new Error('Error al actualizar la prestación');
    }

    return await response.json();
  } catch (error) {
    console.error('Error al actualizar prestación:', error);
    throw error;
  }
}

async function registrarPago(prestacionId, data) {
  try {
    console.log('Enviando datos de pago:', { prestacionId, data });
    
    const response = await fetch(`${BASE_URL}/prestaciones/${prestacionId}/pagos`, {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(data)
    });

    const responseText = await response.text();
    console.log('Respuesta del servidor (texto):', responseText);

    if (!response.ok) {
      console.log('Estado de la respuesta:', response.status);
      console.log('Headers:', Object.fromEntries([...response.headers]));
      throw new Error(`Error del servidor: ${response.status} - ${responseText}`);
    }

    let result;
    try {
      result = JSON.parse(responseText);
    } catch (e) {
      throw new Error(`Error al parsear la respuesta: ${responseText}`);
    }

    console.log('Pago registrado:', result);
    return result;
  } catch (error) {
    console.error('Error detallado en registrarPago:', error);
    throw error;
  }
}

async function eliminarPrestacion(id) {
  try {
    const response = await fetch(`${BASE_URL}/prestaciones/${id}`, {
      method: 'DELETE'
    });

    if (!response.ok) {
      throw new Error('Error al eliminar la prestación');
    }
  } catch (error) {
    console.error('Error al eliminar prestación:', error);
    throw error;
  }
}

function calcularTotalAdeudado(prestaciones) {
  return prestaciones.reduce((total, p) => {
    const totalPagos = (p.pagos || []).reduce((sum, pago) => sum + pago.monto, 0);
    return total + (p.precio - totalPagos);
  }, 0);
}

function formatearMoneda(valor) {
  return new Intl.NumberFormat('es-AR', {
    style: 'currency',
    currency: 'ARS'
  }).format(valor);
}

function renderizarPrestaciones(prestaciones) {
  const tbody = document.getElementById('prestacionesTableBody');
  tbody.innerHTML = prestaciones.map(p => {
    const totalPagos = (p.pagos || []).reduce((sum, pago) => sum + pago.monto, 0);
    
    // Obtener el nombre del tratamiento de forma segura
    const nombreTratamiento = p.tratamientoId?.nombre || 'Sin tratamiento';
    
    return `
      <tr class="bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700" data-id="${p._id}">
        <td class="px-4 py-2 text-gray-900 dark:text-gray-200">
          ${nombreTratamiento}
        </td>
        <td class="px-4 py-2 text-right text-gray-900 dark:text-gray-200">
          ${formatearMoneda(p.precio || 0)}
        </td>
        <td class="px-4 py-2 text-right">
          <div class="flex flex-col items-end">
            <span class="text-gray-900 dark:text-gray-200">${formatearMoneda(totalPagos)}</span>
            <button 
              onclick="registrarPagoHandler('${p._id}')"
              class="mt-1 text-sm text-blue-600 hover:text-blue-700 dark:text-blue-500 dark:hover:text-blue-400"
            >
              Agregar pago
            </button>
          </div>
        </td>
        <td class="px-4 py-2 text-right">
          <div class="flex justify-end space-x-2">
            <button 
              onclick="editarPrestacionHandler('${p._id}')"
              class="p-2 text-blue-600 hover:text-blue-700 dark:text-blue-500 dark:hover:text-blue-400"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" 
                   stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
              </svg>
            </button>
            <button 
              onclick="eliminarPrestacionHandler('${p._id}')"
              class="p-2 text-red-600 hover:text-red-700 dark:text-red-500 dark:hover:text-red-400"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" 
                   stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 6h18"/>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>
                <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
              </svg>
            </button>
          </div>
        </td>
      </tr>
    `;
  }).join('');
  
  const total = calcularTotalAdeudado(prestaciones);
  const totalElement = document.getElementById('totalAdeudado');
  totalElement.textContent = formatearMoneda(total);
  totalElement.className = `px-4 py-2 text-right ${total < 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400'}`;
}

function mostrarNotificacion(mensaje, tipo = 'success') {
  const notificacionExistente = document.querySelector('.notificacion');
  if (notificacionExistente) {
    notificacionExistente.remove();
  }

  const notificacion = document.createElement('div');
  notificacion.className = `notificacion fixed right-4 top-4 z-50 rounded-lg p-4 shadow-lg transition-opacity duration-300 ${
    tipo === 'success' 
      ? 'bg-green-500 dark:bg-green-600' 
      : 'bg-red-500 dark:bg-red-600'
  } text-white`;
  notificacion.textContent = mensaje;

  document.body.appendChild(notificacion);

  setTimeout(() => {
    notificacion.style.opacity = '0';
    setTimeout(() => notificacion.remove(), 300);
  }, 3000);
}

async function cargarPrestaciones() {
  try {
    if (!dni) {
      throw new Error('DNI no proporcionado');
    }

    const paciente = await obtenerPacientePorDni();
    const pacienteId = paciente._id || paciente.id;
    
    if (!pacienteId) {
      throw new Error('No se pudo obtener el ID del paciente');
    }

    const prestaciones = await obtenerPrestaciones(pacienteId);
    renderizarPrestaciones(prestaciones);
  } catch (error) {
    console.error('Error al cargar prestaciones:', error);
    document.getElementById('prestacionesTableBody').innerHTML = `
      <tr>
        <td colspan="4" class="px-4 py-2 text-center text-red-600 dark:text-red-400">
          Error al cargar los datos: ${error.message}
        </td>
      </tr>
    `;
  }
}

async function cargarTratamientos() {
  try {
    const tratamientos = await obtenerTratamientos();
    const selectElements = document.querySelectorAll('select[name="tratamiento"]');
    
    const optionsHTML = tratamientos.map(t => 
      `<option value="${t._id}" data-precio="${t.precio}">${t.nombre}</option>`
    ).join('');

    selectElements.forEach(select => {
      select.innerHTML = '<option value="">Seleccione un tratamiento</option>' + optionsHTML;
    });
  } catch (error) {
    console.error('Error al cargar tratamientos:', error);
    mostrarNotificacion('Error al cargar los tratamientos', 'error');
  }
}

window.registrarPagoHandler = function(prestacionId) {
  const modal = document.getElementById('pagoModal');
  const form = document.getElementById('pagoForm');
  const prestacionIdInput = form.querySelector('input[name="prestacionId"]');
  
  prestacionIdInput.value = prestacionId;
  modal.classList.remove('hidden');

  // Establecer la fecha actual por defecto
  const fechaInput = form.querySelector('input[name="fechaPago"]');
  const today = new Date().toISOString().split('T')[0];
  fechaInput.value = today;
};

window.eliminarPrestacionHandler = async function(id) {
  if (confirm('¿Está seguro de eliminar esta prestación?')) {
    try {
      await eliminarPrestacion(id);
      mostrarNotificacion('Prestación eliminada correctamente', 'success');
      await cargarPrestaciones();
    } catch (error) {
      console.error('Error al eliminar prestación:', error);
      mostrarNotificacion('Error al eliminar la prestación', 'error');
    }
  }
};

window.editarPrestacionHandler = async function(id) {
  try {
    const paciente = await obtenerPacientePorDni();
    const pacienteId = paciente._id || paciente.id;
    const prestaciones = await obtenerPrestaciones(pacienteId);
    const prestacion = prestaciones.find(p => p._id === id);

    if (!prestacion) {
      throw new Error('No se encontró la prestación');
    }

    const modal = document.getElementById('editarPrestacionModal');
    const form = document.getElementById('editarPrestacionForm');
    
    // Establecer los valores del formulario
    form.querySelector('input[name="prestacionId"]').value = prestacion._id;
    const selectTratamiento = form.querySelector('select[name="tratamiento"]');
    selectTratamiento.value = prestacion.tratamientoId._id; // Asegurar que usamos el _id del tratamiento
    form.querySelector('input[name="precio"]').value = prestacion.precio;

    // Agregar el evento change al select para cuando cambie el tratamiento
    selectTratamiento.addEventListener('change', (e) => {
      const selectedOption = e.target.options[e.target.selectedIndex];
      const precio = selectedOption.dataset.precio;
      if (precio) {
        form.querySelector('input[name="precio"]').value = precio;
      }
    });

    modal.classList.remove('hidden');
  } catch (error) {
    console.error('Error al abrir el modal de edición:', error);
    mostrarNotificacion(
      `Error al cargar los datos de la prestación: ${error.message}`, 
      'error'
    );
  }
};

document.addEventListener('DOMContentLoaded', () => {
  const prestacionModal = document.getElementById('prestacionModal');
  const editarModal = document.getElementById('editarPrestacionModal');
  const pagoModal = document.getElementById('pagoModal');
  const prestacionForm = document.getElementById('prestacionForm');
  const editarForm = document.getElementById('editarPrestacionForm');
  const pagoForm = document.getElementById('pagoForm');
  const nuevaPrestacionBtn = document.getElementById('nuevaPrestacionBtn');

  // Event listeners para tratamientos
  const tratamientoSelects = document.querySelectorAll('select[name="tratamiento"]');
  tratamientoSelects.forEach(select => {
    select.addEventListener('change', (e) => {
      const selectedOption = e.target.options[e.target.selectedIndex];
      const precio = selectedOption.dataset.precio;
      if (precio) {
        const form = e.target.closest('form');
        form.querySelector('input[name="precio"]').value = precio;
      }
    });
  });

  // Manejador para nueva prestación
  nuevaPrestacionBtn.addEventListener('click', () => {
    prestacionModal.classList.remove('hidden');
  });

  // Formulario de nueva prestación
    // Formulario de nueva prestación
    prestacionForm.onsubmit = async (e) => {
  e.preventDefault();
  const submitButton = prestacionForm.querySelector('button[type="submit"]');
  const originalText = submitButton.textContent;
  submitButton.disabled = true;
  submitButton.textContent = 'Guardando...';

  try {
    const paciente = await obtenerPacientePorDni();
    const pacienteId = paciente._id || paciente.id;
    
    const formData = new FormData(prestacionForm);
    const tratamientoId = formData.get('tratamiento');
    
    if (!tratamientoId) {
      throw new Error('Debe seleccionar un tratamiento');
    }

    const prestacionData = {
      pacienteId,
      tratamientoId,
      precio: parseFloat(formData.get('precio')),
      pagos: []
    };

    console.log('Datos a enviar:', prestacionData);
    await crearPrestacion(prestacionData);
    await cargarPrestaciones();
    prestacionModal.classList.add('hidden');
    prestacionForm.reset();
    
    mostrarNotificacion('Prestación creada exitosamente', 'success');
  } catch (error) {
    console.error('Error al crear prestación:', error);
    mostrarNotificacion(
      'Error al crear la prestación: ' + (error.message || 'Error desconocido'),
      'error'
    );
  } finally {
    submitButton.disabled = false;
    submitButton.textContent = originalText;
  }
};

  // Formulario de edición
  editarForm.onsubmit = async (e) => {
  e.preventDefault();
  const submitButton = editarForm.querySelector('button[type="submit"]');
  const originalText = submitButton.textContent;
  submitButton.disabled = true;
  submitButton.textContent = 'Actualizando...';

  try {
    const formData = new FormData(editarForm);
    const prestacionId = formData.get('prestacionId');
    const tratamientoId = formData.get('tratamiento');

    if (!tratamientoId) {
      throw new Error('Debe seleccionar un tratamiento');
    }

    const prestacionData = {
      tratamientoId,
      precio: parseFloat(formData.get('precio'))
    };

    console.log('Datos a actualizar:', prestacionData);
    await actualizarPrestacion(prestacionId, prestacionData);
    await cargarPrestaciones();
    editarModal.classList.add('hidden');
    editarForm.reset();
    
    mostrarNotificacion('Prestación actualizada exitosamente', 'success');
  } catch (error) {
    console.error('Error al actualizar prestación:', error);
    mostrarNotificacion(
      'Error al actualizar la prestación: ' + (error.message || 'Error desconocido'),
      'error'
    );
  } finally {
    submitButton.disabled = false;
    submitButton.textContent = originalText;
  }
};

  // Formulario de pago
  pagoForm.onsubmit = async (e) => {
  e.preventDefault();
  const submitButton = pagoForm.querySelector('button[type="submit"]');
  const originalText = submitButton.textContent;
  submitButton.disabled = true;
  submitButton.textContent = 'Registrando...';

  try {
    const formData = new FormData(pagoForm);
    const prestacionId = formData.get('prestacionId');
    
    if (!prestacionId) {
      throw new Error('No se encontró el ID de la prestación');
    }

    const pagoData = {
      monto: parseFloat(formData.get('montoPago')),
      fecha: formData.get('fechaPago')
    };

    console.log('Enviando datos de pago:', { prestacionId, pagoData });

    const resultado = await registrarPago(prestacionId, pagoData);
    console.log('Respuesta del registro de pago:', resultado);

    await cargarPrestaciones();
    pagoModal.classList.add('hidden');
    pagoForm.reset();
    
    mostrarNotificacion('Pago registrado exitosamente', 'success');
  } catch (error) {
    console.error('Error detallado al registrar pago:', error);
    mostrarNotificacion(
      `Error al registrar el pago: ${error.message}`,
      'error'
    );
  } finally {
    submitButton.disabled = false;
    submitButton.textContent = originalText;
  }
};

  // Manejadores para cerrar modales
  const modales = [
    { modal: prestacionModal, form: prestacionForm },
    { modal: editarModal, form: editarForm },
    { modal: pagoModal, form: pagoForm}
  ];

  // Botones cancelar
  document.getElementById('cancelarBtn').addEventListener('click', () => {
    prestacionModal.classList.add('hidden');
    prestacionForm.reset();
  });

  document.getElementById('cancelarEditarBtn').addEventListener('click', () => {
    editarModal.classList.add('hidden');
    editarForm.reset();
  });

  document.getElementById('cancelarPagoBtn').addEventListener('click', () => {
    pagoModal.classList.add('hidden');
    pagoForm.reset();
  });

  // Cerrar modales al hacer clic fuera
  window.addEventListener('click', (e) => {
    modales.forEach(({ modal, form }) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
        form.reset();
      }
    });
  });

  // Cerrar modales con Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      modales.forEach(({ modal, form }) => {
        modal.classList.add('hidden');
        form.reset();
      });
    }
  });

  // Cargar datos iniciales
  cargarTratamientos();
  cargarPrestaciones();
});

document.addEventListener('astro:page-load', () => {
  cargarTratamientos();
  cargarPrestaciones();
});
</script>