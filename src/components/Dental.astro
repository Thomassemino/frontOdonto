---
const TEETH = {
  superior: [18,17,16,15,14,13,12,11,21,22,23,24,25,26,27,28],
  inferior: [48,47,46,45,44,43,42,41,31,32,33,34,35,36,37,38]
};

const TREATMENTS = {
  "Caries para hacer": {color: "bg-blue-500", icon: "🔵", clase: "blue"},
  "Arreglo hecho": {color: "bg-red-500", icon: "🔴", clase: "red"},
  "Caries filtrada": {color: "bg-blue-500", icon: "⭕️", clase: "blue-circle"},
  "Por fuera": {color: "bg-red-500", icon: "⬤", clase: "red-solid"},
  "TC para hacer": {color: "bg-blue-500", icon: "TC", clase: "blue-tc"},
  "TC hecho": {color: "bg-red-500", icon: "TC", clase: "red-tc"},
  "Corona para hacer": {color: "bg-blue-500", icon: "⭕️", clase: "blue-crown"},
  "Corona hecha": {color: "bg-red-500", icon: "⭕️", clase: "red-crown"},
  "Extracción para hacer": {color: "bg-blue-500", icon: "❌", clase: "blue-x"},
  "Extracción hecha": {color: "bg-red-500", icon: "❌", clase: "red-x"},
  "Implante para hacer": {color: "bg-blue-500", icon: "IMP", clase: "blue-imp"},
  "Implante hecho": {color: "bg-red-500", icon: "IMP", clase: "red-imp"}
};

interface Props {
  dni: string;
}

const { dni } = Astro.props;
const BASE_URL = "https://odontoback-production.up.railway.app/api";
---

<div class="max-w-full mx-auto p-4 bg-gray-800">
  <div class="bg-gray-800 rounded-lg shadow-lg p-6">
    <h2 class="text-2xl font-bold text-white mb-6">Odontograma Digital</h2>

    <!-- Treatment Legend -->
    <div class="flex flex-wrap gap-4 mb-8 p-4 bg-gray-700 rounded-lg">
      {Object.entries(TREATMENTS).map(([name, {color, icon}]) => (
        <div class="flex items-center gap-2 cursor-pointer hover:scale-105 transition-transform" 
             data-treatment={name}>
          <span class={`w-4 h-4 rounded-full ${color}`}></span>
          <span class="text-sm font-medium text-white">{name}</span>
          <span>{icon}</span>
        </div>
      ))}
    </div>

    <!-- Superior Teeth -->
    <div class="mb-12">
      <h3 class="text-center text-sm font-medium text-gray-300 mb-4">Superior</h3>
      <div class="grid grid-cols-16 gap-2">
        {TEETH.superior.map((tooth) => (
          <div class="tooth-container group" data-tooth={tooth}>
            <div class="aspect-square relative transform transition-transform hover:scale-110">
              <div class="tooth-parts">
                <div class="absolute inset-[25%] bg-gray-700 border-2 border-gray-500 rounded tooth-part 
                            hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="central"></div>
                <div class="absolute top-0 left-[25%] right-[25%] h-[25%] bg-gray-700 border-2 border-gray-500 
                            tooth-part hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="superior"></div>
                <div class="absolute bottom-0 left-[25%] right-[25%] h-[25%] bg-gray-700 border-2 border-gray-500 
                            tooth-part hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="inferior"></div>
                <div class="absolute top-[25%] bottom-[25%] left-0 w-[25%] bg-gray-700 border-2 border-gray-500 
                            tooth-part hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="izquierda"></div>
                <div class="absolute top-[25%] bottom-[25%] right-0 w-[25%] bg-gray-700 border-2 border-gray-500 
                            tooth-part hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="derecha"></div>
              </div>
              <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs font-medium text-gray-300
                         opacity-0 group-hover:opacity-100 transition-opacity">{tooth}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Inferior Teeth -->
    <div class="mb-12">
      <h3 class="text-center text-sm font-medium text-gray-300 mb-4">Inferior</h3>
      <div class="grid grid-cols-16 gap-2">
        {TEETH.inferior.map((tooth) => (
          <div class="tooth-container group" data-tooth={tooth}>
            <div class="aspect-square relative transform transition-transform hover:scale-110">
              <div class="tooth-parts">
                <div class="absolute inset-[25%] bg-gray-700 border-2 border-gray-500 rounded tooth-part 
                            hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="central"></div>
                <div class="absolute top-0 left-[25%] right-[25%] h-[25%] bg-gray-700 border-2 border-gray-500 
                            tooth-part hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="superior"></div>
                <div class="absolute bottom-0 left-[25%] right-[25%] h-[25%] bg-gray-700 border-2 border-gray-500 
                            tooth-part hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="inferior"></div>
                <div class="absolute top-[25%] bottom-[25%] left-0 w-[25%] bg-gray-700 border-2 border-gray-500 
                            tooth-part hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="izquierda"></div>
                <div class="absolute top-[25%] bottom-[25%] right-0 w-[25%] bg-gray-700 border-2 border-gray-500 
                            tooth-part hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="derecha"></div>
              </div>
              <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs font-medium text-gray-300
                         opacity-0 group-hover:opacity-100 transition-opacity">{tooth}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Control Panel -->
    <div class="mt-8 space-y-4">
      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1">Tratamiento</label>
          <select id="treatment-select" class="w-full rounded-md border-gray-600 bg-gray-700 text-white">
            <option value="">Seleccionar tratamiento</option>
            {Object.entries(TREATMENTS).map(([name]) => (
              <option value={name}>{name}</option>
            ))}
          </select>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1">Observaciones</label>
          <textarea id="notes" rows="1" class="w-full rounded-md border-gray-600 bg-gray-700 text-white"></textarea>
        </div>
      </div>

      <div class="flex justify-between items-center">
        <div id="notification" class="hidden px-4 py-2 rounded-md"></div>
        <div class="flex space-x-3">
          <button id="reset" class="px-4 py-2 border border-gray-600 rounded-md text-gray-300 hover:bg-gray-700">
            Reiniciar
          </button>
          <button id="save" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed">
            Guardar
          </button>
        </div>
      </div>
    </div>

    <!-- Treatment History -->
    <div class="mt-8">
      <h3 class="text-lg font-medium text-white mb-4">Historial de Tratamientos</h3>
      <div id="treatment-history" class="space-y-2">
        <!-- Treatments will be added here dynamically -->
      </div>
    </div>
  </div>
</div>

<style>
.grid-cols-16 {
  grid-template-columns: repeat(16, minmax(0, 1fr));
}

.tooth-part {
  transition: all 0.2s;
  cursor: pointer;
}

.tooth-part:hover {
  background-color: #374151;
}

.tooth-part.selected {
  border-color: #3b82f6;
  border-width: 3px;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: translateY(0); }
}

.notification-animation {
  animation: fadeIn 0.3s ease-out;
}

/* Treatment Colors and Styles */
.blue { background-color: #3b82f6 !important; }
.red { background-color: #ef4444 !important; }
.blue-circle::after,
.red-circle::after { 
  content: "⭕️";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: white;
}
.blue-tc::after,
.red-tc::after { 
  content: "TC";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 0.8em;
  font-weight: bold;
  color: white;
}
.blue-imp::after,
.red-imp::after { 
  content: "IMP";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 0.8em;
  font-weight: bold;
  color: white;
}
.blue-x::after,
.red-x::after {
  content: "❌";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
.blue-crown::after,
.red-crown::after {
  content: "⭕️";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: white;
}
</style>

<script type="module" define:vars={{ dni, TREATMENTS, BASE_URL }}>
  let patientIdFromApi = null;
  let selectedTooth = null;
  let selectedSurface = null;
  let pendingTreatments = [];

  document.addEventListener("DOMContentLoaded", async () => {
  try {
    console.log('Loading patient with DNI:', dni);
    const response = await fetch(`${BASE_URL}/paciente/findByDni/${dni}`);
    const responseText = await response.text();
    console.log('Raw API Response:', responseText);
    
    if (!response.ok) throw new Error('Paciente no encontrado');
    const data = JSON.parse(responseText);
    console.log('Parsed API Response:', data);
    
    patientIdFromApi = data.paciente?.id;
    console.log('Patient ID from API:', patientIdFromApi);
    
    if (!patientIdFromApi) {
      showNotification('Error: ID de paciente no encontrado', 'error');
      return;
    }

    initializeToothListeners();
    initializeTreatmentListeners();
    loadExistingTreatments();
    
    document.getElementById("save").addEventListener("click", saveTreatment);
    document.getElementById("reset").addEventListener("click", resetSelection);
  } catch (error) {
    console.error('Error loading patient:', error);
    showNotification('Error al cargar paciente', 'error');
  }
});

function initializeToothListeners() {
  document.querySelectorAll('.tooth-part').forEach(part => {
    part.addEventListener('click', (e) => {
      const toothElement = e.target.closest('.tooth-container');
      const surface = e.target.dataset.surface;
      const tooth = toothElement.dataset.tooth;
      
      selectToothPart(tooth, surface, e.target);
    });
  });
}

function initializeTreatmentListeners() {
  document.querySelectorAll('[data-treatment]').forEach(elem => {
    elem.addEventListener('click', () => {
      const treatment = elem.dataset.treatment;
      document.getElementById('treatment-select').value = treatment;
    });
  });
}

function selectToothPart(tooth, surface, element) {
  element.classList.add('selected');
  selectedTooth = tooth;
  selectedSurface = surface;
  
  const treatment = document.getElementById('treatment-select').value;
  if (treatment) {
    const treatmentInfo = TREATMENTS[treatment];
    Object.values(TREATMENTS).forEach(t => {
      element.classList.remove(t.clase);
    });
    element.classList.add(treatmentInfo.clase);
    
    pendingTreatments.push({
      numeroDiente: tooth,
      superficie: surface,
      tratamiento: treatment,
      elemento: element
    });
  }
  
  document.getElementById('save').disabled = false;
}

async function loadExistingTreatments() {
  try {
    console.log('Loading treatments for patient:', patientIdFromApi);
    const response = await fetch(`${BASE_URL}/odontograma/patient/${patientIdFromApi}`);
    
    if (!response.ok) {
      console.log('Response not OK:', await response.text());
      throw new Error('Error al cargar tratamientos');
    }
    
    const treatments = await response.json();
    console.log('Loaded treatments:', treatments);
    const historyContainer = document.getElementById('treatment-history');
    historyContainer.innerHTML = '';

    if (treatments.length === 0) {
      historyContainer.innerHTML = `
        <div class="text-gray-400 text-center py-4">
          No hay tratamientos registrados
        </div>
      `;
      return;
    }

    treatments.forEach(odontograma => {
      odontograma.dientes.forEach(diente => {
        updateToothVisual(diente);
        addTreatmentToHistory(diente, odontograma.fecha);
      });
    });
  } catch (error) {
    console.error('Error loading treatments:', error);
    showNotification('Error al cargar tratamientos', 'error');
  }
}

function updateToothVisual(diente) {
  const toothElement = document.querySelector(`[data-tooth="${diente.numeroDiente}"]`);
  if (!toothElement) return;
  const surfaceElement = toothElement.querySelector(`[data-surface="${diente.superficie}"]`);
  if (!surfaceElement) return;

  const treatment = TREATMENTS[diente.tratamiento];
  if (treatment) {
    Object.values(TREATMENTS).forEach(t => {
      surfaceElement.classList.remove(t.clase);
    });
    surfaceElement.classList.add(treatment.clase);
  }
}

function addTreatmentToHistory(diente, fecha) {
  const historyContainer = document.getElementById('treatment-history');
  const treatment = TREATMENTS[diente.tratamiento];
  
  const treatmentRecord = document.createElement('div');
  treatmentRecord.className = 'p-3 bg-gray-700 rounded-md hover:shadow-md transition-shadow';
  treatmentRecord.innerHTML = `
    <div class="flex justify-between items-center">
      <div class="flex items-center gap-2">
        <span class="font-medium text-white">Diente ${diente.numeroDiente}</span>
        <span class="text-sm ${treatment?.color} rounded-full w-4 h-4"></span>
      </div>
      <span class="text-sm text-gray-400">
        ${new Date(fecha).toLocaleDateString()}
      </span>
    </div>
    <div class="text-sm mt-1 flex items-center gap-1 text-gray-300">
      <span>${treatment?.icon}</span>
      <span>${diente.tratamiento}</span>
      <span class="text-gray-500">-</span>
      <span>${diente.superficie}</span>
    </div>
    ${diente.notas ? `
      <div class="text-sm text-gray-400 mt-1 flex items-center gap-1">
        <span>📝</span>
        <span>${diente.notas}</span>
      </div>
    ` : ''}
  `;
  historyContainer.prepend(treatmentRecord);
  updateToothVisual();
}

async function saveTreatment() {
  console.log('Starting save with pending treatments:', pendingTreatments);
  if (!validatePendingTreatments()) return;

  const saveButton = document.getElementById('save');
  saveButton.disabled = true;
  saveButton.innerHTML = '<span class="animate-pulse">Guardando...</span>';

  try {
    const notes = document.getElementById('notes').value;
    console.log('Saving treatment with notes:', notes);
    
    for (const treatment of pendingTreatments) {
      const dienteData = {
        numeroDiente: treatment.numeroDiente,
        superficie: treatment.superficie,
        tratamiento: treatment.tratamiento,
        notas: notes
      };
      console.log('Sending diente data:', dienteData);

      const response = await fetch(`${BASE_URL}/odontograma`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          idPaciente: patientIdFromApi,
          dientes: [dienteData]
        })
      });

      console.log('Save response status:', response.status);
      if (!response.ok) {
        const errorText = await response.text();
        console.log('Error response:', errorText);
        throw new Error('Error al guardar');
      }
      
      const savedData = await response.json();
      console.log('Saved data:', savedData);
      addTreatmentToHistory(dienteData, new Date());
    }

    showNotification('Tratamientos guardados exitosamente', 'success');
    resetSelection();
  } catch (error) {
    console.error('Error saving treatments:', error);
    showNotification('Error al guardar los tratamientos', 'error');
  } finally {
    saveButton.disabled = false;
    saveButton.innerHTML = 'Guardar';
  }
}

function validatePendingTreatments() {
  if (pendingTreatments.length === 0) {
    showNotification('Por favor seleccione al menos un tratamiento', 'error');
    return false;
  }

  const treatment = document.getElementById('treatment-select').value;
  if (!treatment) {
    showNotification('Por favor seleccione un tratamiento', 'error');
    return false;
  }

  return true;
}

function showNotification(message, type) {
  const notification = document.getElementById('notification');
  notification.textContent = message;
  notification.className = `px-4 py-2 rounded-md notification-animation ${
    type === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
  }`;
  notification.style.display = 'block';

  setTimeout(() => {
    notification.style.display = 'none';
  }, 3000);
}

function resetSelection() {
  selectedTooth = null;
  selectedSurface = null;
  pendingTreatments = [];
  
  document.querySelectorAll('.tooth-part.selected').forEach(el => {
    el.classList.remove('selected');
    Object.values(TREATMENTS).forEach(t => {
      el.classList.remove(t.clase);
    });
  });
  
  document.getElementById('treatment-select').value = '';
  document.getElementById('notes').value = '';
  document.getElementById('save').disabled = true;
}
</script>