---
const TEETH = {
  superior: [18,17,16,15,14,13,12,11,21,22,23,24,25,26,27,28],
  inferior: [48,47,46,45,44,43,42,41,31,32,33,34,35,36,37,38]
};

const TREATMENTS = {
  "Restauración": {color: "bg-blue-500", icon: "🔵", clase: "blue", hover: "hover:bg-blue-600"},
  "Carilla de Porcelana": {color: "bg-purple-500", icon: "🟣", clase: "purple", hover: "hover:bg-purple-600"},
  "Sellador de Fisuras": {color: "bg-green-500", icon: "🟢", clase: "green", hover: "hover:bg-green-600"}, 
  "Corona": {color: "bg-yellow-500", icon: "🟡", clase: "yellow", hover: "hover:bg-yellow-600"}
};

const SURFACES = [
  "Incisal",
  "Oclusal", 
  "Mesial",
  "Distal",
  "Bucal",
  "Labial", 
  "Palatina",
  "Lingual",
  "Cervical"
];

interface Props {
  patientId: string;
}

const { patientId } = Astro.props;
---

<div class="max-w-6xl mx-auto p-4">
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6">
    <!-- Header -->
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-2xl font-bold text-gray-800 dark:text-white">Odontograma Digital</h2>
      <button id="theme-toggle" class="p-2 rounded-lg bg-gray-100 dark:bg-gray-700">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707">
          </path>
        </svg>
      </button>
    </div>

    <!-- Treatment Legend -->
    <div class="flex flex-wrap gap-4 mb-8 p-4 bg-gray-50 dark:bg-gray-700 rounded-lg">
      {Object.entries(TREATMENTS).map(([name, {color, icon}]) => (
        <div class="flex items-center gap-2 cursor-pointer hover:scale-105 transition-transform" 
             data-treatment={name}>
          <span class={`w-4 h-4 rounded-full ${color}`}></span>
          <span class="text-sm font-medium dark:text-white">{name}</span>
          <span>{icon}</span>
        </div>
      ))}
    </div>

    <!-- Superior Teeth -->
    <div class="mb-12">
      <h3 class="text-center text-sm font-medium text-gray-500 dark:text-gray-400 mb-4">Superior</h3>
      <div class="grid grid-cols-16 gap-2">
        {TEETH.superior.map((tooth) => (
          <div class="tooth-container group" data-tooth={tooth}>
            <div class="aspect-square relative transform transition-transform hover:scale-110">
              <div class="tooth-parts">
                <div class="absolute inset-[25%] bg-white dark:bg-gray-700 border-2 border-gray-400 rounded tooth-part 
                            hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="central"></div>
                <div class="absolute top-0 left-[25%] right-[25%] h-[25%] bg-white dark:bg-gray-700 border-2 border-gray-400 
                            tooth-part hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="vestibular"></div>
                <div class="absolute bottom-0 left-[25%] right-[25%] h-[25%] bg-white dark:bg-gray-700 border-2 border-gray-400 
                            tooth-part hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="palatino"></div>
                <div class="absolute top-[25%] bottom-[25%] left-0 w-[25%] bg-white dark:bg-gray-700 border-2 border-gray-400 
                            tooth-part hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="mesial"></div>
                <div class="absolute top-[25%] bottom-[25%] right-0 w-[25%] bg-white dark:bg-gray-700 border-2 border-gray-400 
                            tooth-part hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="distal"></div>
              </div>
              <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs font-medium dark:text-white 
                         opacity-0 group-hover:opacity-100 transition-opacity">{tooth}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Inferior Teeth -->
    <div class="mb-12">
      <h3 class="text-center text-sm font-medium text-gray-500 dark:text-gray-400 mb-4">Inferior</h3>
      <div class="grid grid-cols-16 gap-2">
        {TEETH.inferior.map((tooth) => (
          <div class="tooth-container group" data-tooth={tooth}>
            <div class="aspect-square relative transform transition-transform hover:scale-110">
              <div class="tooth-parts">
                <div class="absolute inset-[25%] bg-white dark:bg-gray-700 border-2 border-gray-400 rounded tooth-part 
                            hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="central"></div>
                <div class="absolute top-0 left-[25%] right-[25%] h-[25%] bg-white dark:bg-gray-700 border-2 border-gray-400 
                            tooth-part hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="vestibular"></div>
                <div class="absolute bottom-0 left-[25%] right-[25%] h-[25%] bg-white dark:bg-gray-700 border-2 border-gray-400 
                            tooth-part hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="lingual"></div>
                <div class="absolute top-[25%] bottom-[25%] left-0 w-[25%] bg-white dark:bg-gray-700 border-2 border-gray-400 
                            tooth-part hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="mesial"></div>
                <div class="absolute top-[25%] bottom-[25%] right-0 w-[25%] bg-white dark:bg-gray-700 border-2 border-gray-400 
                            tooth-part hover:border-blue-500 hover:shadow-lg transition-all duration-200" 
                     data-surface="distal"></div>
              </div>
              <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs font-medium dark:text-white 
                         opacity-0 group-hover:opacity-100 transition-opacity">{tooth}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Control Panel -->
    <div class="mt-8 space-y-4">
      <div class="grid md:grid-cols-3 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Tratamiento</label>
          <select id="treatment-select" class="w-full rounded-md border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
            <option value="">Seleccionar tratamiento</option>
            {Object.entries(TREATMENTS).map(([name]) => (
              <option value={name}>{name}</option>
            ))}
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Superficie</label>
          <select id="surface-select" class="w-full rounded-md border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
            <option value="">Seleccionar superficie</option>
            {SURFACES.map(surface => (
              <option value={surface}>{surface}</option>
            ))}
          </select>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Observaciones</label>
          <textarea id="notes" rows="1" class="w-full rounded-md border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white"></textarea>
        </div>
      </div>

      <div class="flex justify-between items-center">
        <div id="notification" class="hidden px-4 py-2 rounded-md"></div>
        <div class="flex space-x-3">
          <button id="reset" class="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700">
            Reiniciar
          </button>
          <button id="save" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed">
            Guardar
          </button>
        </div>
      </div>
    </div>

    <!-- Treatment History -->
    <div class="mt-8">
      <h3 class="text-lg font-medium text-gray-800 dark:text-white mb-4">Historial de Tratamientos</h3>
      <div id="treatment-history" class="space-y-2">
        <!-- Treatments will be added here dynamically -->
      </div>
    </div>
  </div>
</div>

<style>
.grid-cols-16 {
  grid-template-columns: repeat(16, minmax(0, 1fr));
}

.tooth-part {
  transition: all 0.2s;
  cursor: pointer;
}

.tooth-part:hover {
  background-color: #f3f4f6;
}

.tooth-part.selected {
  border-color: #3b82f6;
  border-width: 3px;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: translateY(0); }
}

.notification-animation {
  animation: fadeIn 0.3s ease-out;
}

.blue { background-color: #3b82f6; }
.purple { background-color: #9333ea; }
.green { background-color: #22c55e; }
.yellow { background-color: #eab308; }
</style>

<script type="module" define:vars={{patientId, TREATMENTS, SURFACES}}>
let selectedTooth = null;
let selectedSurface = null;
const BASE_URL = "https://odontoback-production.up.railway.app/api";

document.addEventListener('DOMContentLoaded', () => {
  initializeToothListeners();
  initializeTreatmentListeners();
  initializeThemeToggle();
  loadExistingTreatments();
  
  document.getElementById('save').addEventListener('click', saveTreatment);
  document.getElementById('reset').addEventListener('click', resetSelection);
});

function initializeToothListeners() {
  document.querySelectorAll('.tooth-part').forEach(part => {
    part.addEventListener('click', (e) => {
      const toothElement = e.target.closest('.tooth-container');
      const surface = e.target.dataset.surface;
      const tooth = toothElement.dataset.tooth;
      
      selectToothPart(tooth, surface, e.target);
      updateSurfaceSelect(surface);
    });
  });
}

function initializeTreatmentListeners() {
  document.querySelectorAll('[data-treatment]').forEach(elem => {
    elem.addEventListener('click', () => {
      const treatment = elem.dataset.treatment;
      document.getElementById('treatment-select').value = treatment;
    });
  });
}

function initializeThemeToggle() {
  const themeToggle = document.getElementById('theme-toggle');
  const htmlElement = document.documentElement;
  
  themeToggle.addEventListener('click', () => {
    htmlElement.classList.toggle('dark');
    localStorage.setItem('theme', htmlElement.classList.contains('dark') ? 'dark' : 'light');
  });
}

function selectToothPart(tooth, surface, element) {
  document.querySelectorAll('.tooth-part.selected').forEach(el => {
    el.classList.remove('selected');
  });
  
  element.classList.add('selected');
  selectedTooth = tooth;
  selectedSurface = surface;
  
  const saveButton = document.getElementById('save');
  saveButton.disabled = false;
}

function updateSurfaceSelect(surface) {
  const surfaceSelect = document.getElementById('surface-select');
  if(SURFACES.includes(surface)) {
    surfaceSelect.value = surface;
  }
}

async function loadExistingTreatments() {
  try {
    // const response = await fetch(`${BASE_URL}/odontograma/patient/${patientId}`);
    // if (!response.ok) throw new Error('Error al cargar tratamientos');
    
    // const odontogramas = await response.json();
    const historyContainer = document.getElementById('treatment-history');
    historyContainer.innerHTML = '';

    if (!odontogramas?.length) {
      historyContainer.innerHTML = `
        <div class="text-gray-500 dark:text-gray-400 text-center py-4">
          No hay tratamientos registrados
        </div>
      `;
      return;
    }
    
    odontogramas.forEach(odontograma => {
      if (odontograma?.dientes?.length) {
        odontograma.dientes.forEach(diente => {
          if (diente) {
            updateToothVisual(diente);
            addTreatmentToHistory(diente, odontograma.fecha);
          }
        });
      }
    });
  } catch (error) {
    console.error('Error:', error);
    showNotification('Error al cargar tratamientos', 'error');
  }
}

function updateToothVisual(diente) {
  const toothElement = document.querySelector(`[data-tooth="${diente.numeroDiente}"]`);
  if (!toothElement) return;

  diente.superficies.forEach(superficie => {
    const surfaceElement = toothElement.querySelector(`[data-surface="${superficie.toLowerCase()}"]`);
    if (!surfaceElement) return;

    // Remove previous treatment colors
    Object.values(TREATMENTS).forEach(t => {
      surfaceElement.classList.remove(t.color.replace('bg-', ''));
      surfaceElement.classList.remove(t.clase);
    });

    // Add new treatment color
    const treatment = TREATMENTS[diente.tratamiento];
    if (treatment) {
      surfaceElement.classList.add(treatment.color.replace('bg-', ''));
      surfaceElement.classList.add(treatment.clase);
    }
  });
}

function addTreatmentToHistory(diente, fecha) {
  const historyContainer = document.getElementById('treatment-history');
  const treatment = TREATMENTS[diente.tratamiento];
  
  const treatmentRecord = document.createElement('div');
  treatmentRecord.className = 'p-3 bg-gray-50 dark:bg-gray-700 rounded-md hover:shadow-md transition-shadow';
  treatmentRecord.innerHTML = `
    <div class="flex justify-between items-center">
      <div class="flex items-center gap-2">
        <span class="font-medium">Diente ${diente.numeroDiente}</span>
        <span class="text-sm ${treatment?.color} rounded-full w-4 h-4"></span>
      </div>
      <span class="text-sm text-gray-500 dark:text-gray-400">
        ${new Date(fecha).toLocaleDateString()}
      </span>
    </div>
    <div class="text-sm mt-1 flex items-center gap-1">
      <span>${treatment?.icon}</span>
      <span>${diente.tratamiento}</span>
      <span class="text-gray-500">-</span>
      <span>${diente.superficies.join(', ')}</span>
    </div>
    ${diente.notas ? `
      <div class="text-sm text-gray-500 dark:text-gray-400 mt-1 flex items-center gap-1">
        <span>📝</span>
        <span>${diente.notas}</span>
      </div>
    ` : ''}
  `;
  historyContainer.prepend(treatmentRecord);
}

async function saveTreatment() {
  if (!validateForm()) return;

  const saveButton = document.getElementById('save');
  saveButton.disabled = true;
  saveButton.innerHTML = '<span class="animate-pulse">Guardando...</span>';

  try {
    const treatment = document.getElementById('treatment-select').value;
    const notes = document.getElementById('notes').value;

    const dienteData = {
      numeroDiente: selectedTooth,
      superficies: [selectedSurface],
      tratamiento: treatment,
      notas: notes
    };

    // const dienteResponse = await fetch(`${BASE_URL}/diente`, {
    //   method: 'POST',
    //   headers: {'Content-Type': 'application/json'},
    //   body: JSON.stringify(dienteData)
    // });

    if (!dienteResponse.ok) throw new Error('Error al guardar el diente');
    const diente = await dienteResponse.json();

    const odontogramaData = {
      idPaciente: patientId,
      dientes: [diente._id]
    };

    const odontogramaResponse = await fetch(`${BASE_URL}/odontograma`, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(odontogramaData)
    });

    if (!odontogramaResponse.ok) throw new Error('Error al guardar el odontograma');

    updateToothVisual(dienteData);
    addTreatmentToHistory(dienteData, new Date());
    showNotification('Tratamiento guardado exitosamente', 'success');
    resetSelection();
  } catch (error) {
    console.error('Error:', error);
    showNotification('Error al guardar el tratamiento', 'error');
  } finally {
    saveButton.disabled = false;
    saveButton.innerHTML = 'Guardar';
  }
}

function validateForm() {
  if (!selectedTooth || !selectedSurface) {
    showNotification('Por favor seleccione un diente y superficie', 'error');
    return false;
  }

  const treatment = document.getElementById('treatment-select').value;
  if (!treatment) {
    showNotification('Por favor seleccione un tratamiento', 'error');
    return false;
  }

  return true;
}

function showNotification(message, type) {
  const notification = document.getElementById('notification');
  notification.textContent = message;
  notification.className = `px-4 py-2 rounded-md notification-animation ${
    type === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
  }`;
  notification.style.display = 'block';

  setTimeout(() => {
    notification.style.display = 'none';
  }, 3000);
}

function resetSelection() {
  selectedTooth = null;
  selectedSurface = null;
  
  document.querySelectorAll('.tooth-part.selected').forEach(el => {
    el.classList.remove('selected');
  });
  
  document.getElementById('treatment-select').value = '';
  document.getElementById('surface-select').value = '';
  document.getElementById('notes').value = '';
  document.getElementById('save').disabled = true;
}

// Initialize theme
const theme = localStorage.getItem('theme') || 
  (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
if (theme === 'dark') {
  document.documentElement.classList.add('dark');
}
</script>