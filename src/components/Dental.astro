---
const TEETH = {
  superior: [18,17,16,15,14,13,12,11,21,22,23,24,25,26,27,28],
  inferior: [48,47,46,45,44,43,42,41,31,32,33,34,35,36,37,38]
};

const TREATMENTS = {
  "Caries": { icon: "🔵" },
  "Arreglo": { icon: "🔴" },
  "Caries filtrada": { icon: "⭕️" },
  "Por fuera": { icon: "⬤" },
  "TC": { icon: "TC" },
  "Corona": { icon: "⭕️" },
  "Extracción": { icon: "❌" },
  "Implante": { icon: "IMP" }
};

interface Props {
  dni: string;
}

const { dni } = Astro.props;
const BASE_URL = "https://odontoback-production.up.railway.app/api";
---

<div class="max-w-full mx-auto p-4 bg-gray-800">
  <div class="bg-gray-800 rounded-lg shadow-lg p-6">
    <h2 class="text-2xl font-bold text-white mb-6">Odontograma Digital</h2>

    <!-- Treatment Legend -->
    <div class="flex flex-wrap gap-4 mb-8 p-4 bg-gray-700 rounded-lg">
      {Object.entries(TREATMENTS).map(([name, {icon}]) => (
        <div class="flex items-center gap-2 cursor-pointer hover:scale-105 transition-transform" 
             data-treatment={name}>
          <span class="text-sm font-medium text-white">{name}</span>
          <span>{icon}</span>
        </div>
      ))}
    </div>

    <!-- Superior Teeth -->
    <div class="mb-12">
      <h3 class="text-center text-sm font-medium text-gray-300 mb-4">Superior</h3>
      <div class="grid grid-cols-16 gap-2">
        {TEETH.superior.map((tooth) => (
          <div class="tooth-container group" data-tooth={tooth}>
            <div class="aspect-square relative transform transition-transform hover:scale-110">
              <div class="tooth-parts">
                <div class="absolute inset-[25%] bg-gray-700 border-2 border-gray-500 rounded tooth-part" 
                     data-surface="central"></div>
                <div class="absolute top-0 left-[25%] right-[25%] h-[25%] bg-gray-700 border-2 border-gray-500 tooth-part" 
                     data-surface="superior"></div>
                <div class="absolute bottom-0 left-[25%] right-[25%] h-[25%] bg-gray-700 border-2 border-gray-500 tooth-part" 
                     data-surface="inferior"></div>
                <div class="absolute top-[25%] bottom-[25%] left-0 w-[25%] bg-gray-700 border-2 border-gray-500 tooth-part" 
                     data-surface="izquierda"></div>
                <div class="absolute top-[25%] bottom-[25%] right-0 w-[25%] bg-gray-700 border-2 border-gray-500 tooth-part" 
                     data-surface="derecha"></div>
              </div>
              <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs font-medium text-gray-300
                         opacity-0 group-hover:opacity-100 transition-opacity">{tooth}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Inferior Teeth -->
    <div class="mb-12">
      <h3 class="text-center text-sm font-medium text-gray-300 mb-4">Inferior</h3>
      <div class="grid grid-cols-16 gap-2">
        {TEETH.inferior.map((tooth) => (
          <div class="tooth-container group" data-tooth={tooth}>
            <div class="aspect-square relative transform transition-transform hover:scale-110">
              <div class="tooth-parts">
                <div class="absolute inset-[25%] bg-gray-700 border-2 border-gray-500 rounded tooth-part" 
                     data-surface="central"></div>
                <div class="absolute top-0 left-[25%] right-[25%] h-[25%] bg-gray-700 border-2 border-gray-500 tooth-part" 
                     data-surface="superior"></div>
                <div class="absolute bottom-0 left-[25%] right-[25%] h-[25%] bg-gray-700 border-2 border-gray-500 tooth-part" 
                     data-surface="inferior"></div>
                <div class="absolute top-[25%] bottom-[25%] left-0 w-[25%] bg-gray-700 border-2 border-gray-500 tooth-part" 
                     data-surface="izquierda"></div>
                <div class="absolute top-[25%] bottom-[25%] right-0 w-[25%] bg-gray-700 border-2 border-gray-500 tooth-part" 
                     data-surface="derecha"></div>
              </div>
              <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs font-medium text-gray-300
                         opacity-0 group-hover:opacity-100 transition-opacity">{tooth}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Control Panel -->
    <div class="grid md:grid-cols-3 gap-4 mb-4">
      <div>
        <label class="block text-sm font-medium text-gray-300 mb-1">Tratamiento</label>
        <select id="treatment-select" class="w-full rounded-md border-gray-600 bg-gray-700 text-white" required>
          <option value="">Seleccionar tratamiento</option>
          {Object.entries(TREATMENTS).map(([name]) => (
            <option value={name}>{name}</option>
          ))}
        </select>
      </div>
      
      <div>
        <label class="block text-sm font-medium text-gray-300 mb-1">Origen</label>
        <select id="origin-select" class="w-full rounded-md border-gray-600 bg-gray-700 text-white" required>
          <option value="">Seleccionar origen</option>
          <option value="propio">Este estudio</option>
          <option value="otro">Otro estudio</option>
        </select>
      </div>
      
      <div>
        <label class="block text-sm font-medium text-gray-300 mb-1">Observaciones</label>
        <textarea id="notes" rows="1" class="w-full rounded-md border-gray-600 bg-gray-700 text-white"></textarea>
      </div>
    </div>

    <div class="flex justify-between items-center mb-6">
      <div id="notification" class="hidden px-4 py-2 rounded-md"></div>
      <div class="flex space-x-3">
        <button id="clear-all" class="px-4 py-2 border border-red-600 rounded-md text-red-300 hover:bg-red-700/20">
          Limpiar Todo
        </button>
        <button id="reset" class="px-4 py-2 border border-gray-600 rounded-md text-gray-300 hover:bg-gray-700">
          Reiniciar
        </button>
        <button id="save" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed">
          Guardar
        </button>
      </div>
    </div>

    <!-- Treatment History -->
    <div class="mt-8">
      <h3 class="text-lg font-medium text-white mb-4">Historial de Tratamientos</h3>
      <!-- Search -->
      <div class="mb-4">
        <input type="text" 
          id="search-input" 
          placeholder="Buscar por número de diente o tratamiento..." 
          class="w-2/4 rounded-md border-gray-600 bg-gray-700 text-white px-4 py-2"
        />
      </div>
      <div id="treatment-history" class="space-y-2">
        <!-- Treatments will be added here dynamically -->
      </div>
    </div>
  </div>
</div>

<style>
.grid-cols-16 {
  grid-template-columns: repeat(16, minmax(0, 1fr));
}

.tooth-part {
  transition: all 0.2s;
  cursor: pointer;
}

.tooth-part:hover {
  background-color: #374151;
}

.tooth-part.selected {
  border-color: #3b82f6;
  border-width: 3px;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: translateY(0); }
}

.notification-animation {
  animation: fadeIn 0.3s ease-out;
}

.tooth-part[data-origen="propio"] { 
  background-color: #ef444430 !important; 
  border-color: #ef4444 !important;
}

.tooth-part[data-origen="otro"] { 
  background-color: #3b82f630 !important;
  border-color: #3b82f6 !important;
}

.tooth-part[data-treatment]:after {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 0.8em;
  font-weight: bold;
  color: #1f2937;
}

[data-treatment="Caries"]:after { content: "🔵"; }
[data-treatment="Arreglo"]:after { content: "🔴"; }
[data-treatment="Caries filtrada"]:after { content: "⭕️"; }
[data-treatment="Por fuera"]:after { content: "⬤"; }
[data-treatment="TC"]:after { content: "TC"; }
[data-treatment="Corona"]:after { content: "⭕️"; }
[data-treatment="Extracción"]:after { content: "❌"; }
[data-treatment="Implante"]:after { content: "IMP"; }

.tratamiento-item {
  padding: 0.75rem;
  background-color: rgba(55, 65, 81, 0.5);
  backdrop-filter: blur(4px);
  border-radius: 0.5rem;
  margin-bottom: 0.5rem;
  transition: background-color 0.2s;
}

.tratamiento-item:hover {
  background-color: rgba(55, 65, 81, 0.7);
}
</style>

<script type="module" define:vars={{ dni, TREATMENTS, BASE_URL }}>
let idPacienteDeApi = null;

function cargarTratamientosPendientes() {
  return JSON.parse(localStorage.getItem('tratamientosPendientes') || '[]');
}

function guardarTratamientosPendientes(tratamientos) {
  localStorage.setItem('tratamientosPendientes', JSON.stringify(tratamientos));
}

document.addEventListener("DOMContentLoaded", async () => {
  try {
    const respuesta = await fetch(`${BASE_URL}/paciente/findByDni/${dni}`);
    if (!respuesta.ok) throw new Error('Paciente no encontrado');
    
    const datos = JSON.parse(await respuesta.text());
    idPacienteDeApi = datos.paciente?.id;
    
    if (!idPacienteDeApi) {
      mostrarNotificacion('Error: ID de paciente no encontrado', 'error');
      return;
    }

    inicializarEscuchadores();
    await cargarTratamientosExistentes();
    
    const tratamientosPendientes = cargarTratamientosPendientes();
    tratamientosPendientes.forEach(t => {
      const elementoDiente = document.querySelector(`[data-tooth="${t.numeroDiente}"]`);
      if (elementoDiente) {
        if (t.superficie === 'completo') {
          elementoDiente.querySelectorAll('.tooth-part').forEach(superficie => {
            actualizarVisualTratamiento(superficie, t.tratamiento, t.origen);
          });
        } else {
          const elementoSuperficie = elementoDiente.querySelector(`[data-surface="${t.superficie}"]`);
          if (elementoSuperficie) {
            actualizarVisualTratamiento(elementoSuperficie, t.tratamiento, t.origen);
          }
        }
      }
    });

    document.getElementById("save").disabled = tratamientosPendientes.length === 0;
  } catch (error) {
    console.error('Error al cargar paciente:', error);
    mostrarNotificacion('Error al cargar paciente', 'error');
  }
});

function inicializarEscuchadores() {
  document.querySelectorAll('.tooth-part').forEach(parte => {
    parte.addEventListener('click', (e) => {
      const elementoDiente = e.target.closest('.tooth-container');
      const superficie = e.target.dataset.surface;
      const diente = elementoDiente.dataset.tooth;
      seleccionarParteDiente(diente, superficie, e.target);
    });
  });

  document.querySelectorAll('[data-treatment]').forEach(elem => {
    elem.addEventListener('click', () => {
      document.getElementById('treatment-select').value = elem.dataset.treatment;
    });
  });

  document.getElementById('search-input').addEventListener('input', (e) => {
    buscarTratamientos(e.target.value);
  });

  document.getElementById('save').addEventListener('click', guardarTratamiento);
  document.getElementById('reset').addEventListener('click', reiniciarSeleccion);
  document.getElementById('clear-all').addEventListener('click', limpiarTodo);
}

function seleccionarParteDiente(diente, superficie, elemento) {
  const tratamiento = document.getElementById('treatment-select').value;
  const origen = document.getElementById('origin-select').value;
  
  if (!tratamiento || !origen) {
    mostrarNotificacion('Seleccione tratamiento y origen', 'error');
    return;
  }

  const tratamientosPendientes = cargarTratamientosPendientes();

  if (tratamiento === 'Extracción') {
    const elementoDiente = elemento.closest('.tooth-container');
    elementoDiente.querySelectorAll('.tooth-part').forEach(elementoSuperficie => {
      elementoSuperficie.classList.add('selected');
      actualizarVisualTratamiento(elementoSuperficie, tratamiento, origen);
    });

    tratamientosPendientes.push({
      numeroDiente: diente,
      superficie: 'completo',
      tratamiento,
      origen
    });
  } else {
    elemento.classList.add('selected');
    actualizarVisualTratamiento(elemento, tratamiento, origen);
    
    tratamientosPendientes.push({
      numeroDiente: diente,
      superficie,
      tratamiento,
      origen
    });
  }
  
  guardarTratamientosPendientes(tratamientosPendientes);
  document.getElementById('save').disabled = false;
}

function actualizarVisualTratamiento(elemento, tratamiento, origen) {
  if (!TREATMENTS[tratamiento]) return;
  
  elemento.dataset.treatment = tratamiento;
  elemento.dataset.origen = origen;
}

async function cargarTratamientosExistentes() {
  try {
    if (!idPacienteDeApi) throw new Error('ID de paciente no disponible');
    
    const respuesta = await fetch(`${BASE_URL}/odontograma/patient/${idPacienteDeApi}`);
    if (!respuesta.ok) throw new Error('Error al cargar tratamientos');
    
    const tratamientos = JSON.parse(await respuesta.text());
    const contenedorHistorial = document.getElementById('treatment-history');
    contenedorHistorial.innerHTML = '';

    if (!Array.isArray(tratamientos) || tratamientos.length === 0) {
      contenedorHistorial.innerHTML = '<div class="text-gray-400 text-center py-4">No hay tratamientos registrados</div>';
      return;
    }

    tratamientos.sort((a, b) => new Date(b.fecha) - new Date(a.fecha));

    // Primero limpiamos los dientes
    document.querySelectorAll('.tooth-part').forEach(parte => {
      delete parte.dataset.treatment;
      delete parte.dataset.origen;
    });

    // Luego agregamos los tratamientos existentes
    tratamientos.forEach(odontograma => {
      odontograma.dientes.forEach(diente => {
        actualizarVisualDiente(diente);
        agregarTratamientoAlHistorial(diente, odontograma.fecha, odontograma._id);
      });
    });
  } catch (error) {
    console.error('Error al cargar tratamientos:', error);
    mostrarNotificacion('Error al cargar tratamientos', 'error');
  }
}

function actualizarVisualDiente(diente) {
  if (!diente?.numeroDiente || !diente?.superficie || !diente?.tratamiento) return;

  const elementoDiente = document.querySelector(`[data-tooth="${diente.numeroDiente}"]`);
  if (!elementoDiente) return;

  if (diente.superficie === 'completo') {
    elementoDiente.querySelectorAll('.tooth-part').forEach(superficie => {
      actualizarVisualTratamiento(superficie, diente.tratamiento, diente.origen);
    });
  } else {
    const elementoSuperficie = elementoDiente.querySelector(`[data-surface="${diente.superficie}"]`);
    if (elementoSuperficie) {
      actualizarVisualTratamiento(elementoSuperficie, diente.tratamiento, diente.origen);
    }
  }
}

function agregarTratamientoAlHistorial(diente, fecha, id) {
  const contenedorHistorial = document.getElementById('treatment-history');
  const tratamiento = TREATMENTS[diente.tratamiento];
  
  const registroTratamiento = document.createElement('div');
  registroTratamiento.className = 'mb-2 px-4 py-3 bg-gray-700/50 backdrop-blur rounded-lg';
  registroTratamiento.dataset.id = id;
  registroTratamiento.dataset.fecha = new Date(fecha).getTime();
  registroTratamiento.dataset.searchContent = `${diente.numeroDiente} ${diente.tratamiento}`.toLowerCase();
  
  registroTratamiento.innerHTML = `
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="font-medium text-white">Diente ${diente.numeroDiente}</span>
        <span class="text-lg">${tratamiento?.icon}</span>
        <span class="${diente.origen === 'propio' ? 'text-red-400' : 'text-blue-400'} text-sm">
          ${diente.origen === 'propio' ? 'Este estudio' : 'Otro estudio'}
        </span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-sm text-gray-400">${new Date(fecha).toLocaleDateString()}</span>
        <button onclick="eliminarTratamiento('${id}')" class="text-gray-400 hover:text-red-400 transition-colors">
          <span class="text-lg">🗑️</span>
        </button>
      </div>
    </div>
    <div class="mt-1.5 text-sm text-gray-300 flex gap-1 items-center">
      <span>${diente.tratamiento}</span>
      <span class="text-gray-500">-</span>
      <span>${diente.superficie}</span>
    </div>
    ${diente.notas ? `
      <div class="mt-1.5 text-sm text-gray-400 flex items-center gap-1">
        <span>📝</span>
        <span>${diente.notas}</span>
      </div>
    ` : ''}
  `;

  const registros = Array.from(contenedorHistorial.children);
  const index = registros.findIndex(r => parseInt(r.dataset.fecha || 0) < new Date(fecha).getTime());

  if (index === -1) {
    contenedorHistorial.appendChild(registroTratamiento);
  } else {
    contenedorHistorial.insertBefore(registroTratamiento, registros[index]);
  }
}

async function guardarTratamiento() {
  const tratamientosPendientes = cargarTratamientosPendientes();
  if (tratamientosPendientes.length === 0) {
    mostrarNotificacion('No hay tratamientos pendientes', 'error');
    return;
  }

  const botonGuardar = document.getElementById('save');
  botonGuardar.disabled = true;
  botonGuardar.innerHTML = '<span class="animate-pulse">Guardando...</span>';

  try {
    const notas = document.getElementById('notes').value;
    const datosDientes = tratamientosPendientes.map(t => ({
      numeroDiente: t.numeroDiente,
      superficie: t.superficie,
      tratamiento: t.tratamiento,
      origen: t.origen,
      notas
    }));

    const respuesta = await fetch(`${BASE_URL}/odontograma`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        idPaciente: idPacienteDeApi,
        dientes: datosDientes
      })
    });

    if (!respuesta.ok) throw new Error('Error al guardar');
    
    const datosGuardados = await respuesta.json();
    
    // Limpiamos solo los pendientes sin afectar los existentes
    document.querySelectorAll('.tooth-part.selected').forEach(el => {
      el.classList.remove('selected');
    });
    
    localStorage.removeItem('tratamientosPendientes');
    document.getElementById('treatment-select').value = '';
    document.getElementById('origin-select').value = '';
    document.getElementById('notes').value = '';
    document.getElementById('save').disabled = true;

    // Recargamos todos los tratamientos
    await cargarTratamientosExistentes();
    
    mostrarNotificacion('Tratamientos guardados exitosamente', 'success');
  } catch (error) {
    console.error('Error al guardar tratamientos:', error);
    mostrarNotificacion('Error al guardar los tratamientos', 'error');
  } finally {
    botonGuardar.disabled = false;
    botonGuardar.innerHTML = 'Guardar';
  }
}

async function eliminarTratamiento(id) {
  if (!confirm('¿Está seguro de que desea eliminar este tratamiento?')) return;

  try {
    const response = await fetch(`${BASE_URL}/odontograma/${id}`, {
      method: 'DELETE'
    });
    
    if (!response.ok) throw new Error('Error al eliminar tratamiento');
    
    document.querySelector(`[data-id="${id}"]`)?.remove();
    await cargarTratamientosExistentes();
    mostrarNotificacion('Tratamiento eliminado exitosamente', 'success');
  } catch (error) {
    console.error('Error:', error);
    mostrarNotificacion('Error al eliminar el tratamiento', 'error');
  }
}

async function limpiarTodo() {
  if (!confirm('¿Está seguro de que desea eliminar todos los tratamientos?')) return;

  try {
    if (!idPacienteDeApi) throw new Error('ID de paciente no disponible');
    
    const response = await fetch(`${BASE_URL}/odontograma/patient/${idPacienteDeApi}`, {
      method: 'DELETE'
    });
    
    if (!response.ok) throw new Error('Error al eliminar tratamientos');
    
    // Limpiamos la selección y los tratamientos pendientes
    localStorage.removeItem('tratamientosPendientes');
    document.getElementById('treatment-select').value = '';
    document.getElementById('origin-select').value = '';
    document.getElementById('notes').value = '';
    document.getElementById('save').disabled = true;
    
    // Limpiamos los dientes
    document.querySelectorAll('.tooth-part').forEach(parte => {
      parte.classList.remove('selected');
      delete parte.dataset.treatment;
      delete parte.dataset.origen;
    });
    
    document.getElementById('treatment-history').innerHTML = 
      '<div class="text-gray-400 text-center py-4">No hay tratamientos registrados</div>';
    
    mostrarNotificacion('Todos los tratamientos eliminados', 'success');
  } catch (error) {
    console.error('Error:', error);
    mostrarNotificacion('Error al eliminar los tratamientos', 'error');
  }
}

function mostrarNotificacion(mensaje, tipo) {
  const notificacion = document.getElementById('notification');
  notificacion.textContent = mensaje;
  notificacion.className = `px-4 py-2 rounded-md notification-animation ${
    tipo === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
  }`;
  notificacion.style.display = 'block';

  setTimeout(() => {
    notificacion.style.display = 'none';
  }, 3000);
}

function buscarTratamientos(query) {
  const contenedorHistorial = document.getElementById('treatment-history');
  const queryLower = query.toLowerCase();
  
  Array.from(contenedorHistorial.children).forEach(registro => {
    if (!registro.dataset.searchContent) return; // Ignorar mensajes de "No hay tratamientos"
    const visible = registro.dataset.searchContent.includes(queryLower);
    registro.style.display = visible ? 'block' : 'none';
  });
}

function reiniciarSeleccion() {
  localStorage.removeItem('tratamientosPendientes');
  
  // Solo removemos la selección y limpiamos los controles
  document.querySelectorAll('.tooth-part.selected').forEach(el => {
    el.classList.remove('selected');
  });
  
  document.getElementById('treatment-select').value = '';
  document.getElementById('origin-select').value = '';
  document.getElementById('notes').value = '';
  document.getElementById('save').disabled = true;
}

window.eliminarTratamiento = eliminarTratamiento;
</script>