---

const TEETH = {
  superior: [18,17,16,15,14,13,12,11,21,22,23,24,25,26,27,28],
  inferior: [48,47,46,45,44,43,42,41,31,32,33,34,35,36,37,38]
};

const PRIMARY_TEETH = {
  superior: ['55','54','53','52','51','61','62','63','64','65'],
  inferior: ['85','84','83','82','81','71','72','73','74','75']
};

const COLORS = {
  primary: '#3b82f6',    
  secondary: '#ef4444',  
  green: '#22c55e',     
  gray: '#4B5563',      
  background: '#374151',
  ownClinic: 'rgba(59, 130, 246, 0.5)',   // Azul con baja opacidad
  otherClinic: 'rgba(239, 68, 68, 0.5)'    // Rojo con baja opacidad
};

const TREATMENTS = {
  "Caries": { icon: "●", fullTooth: false, color: COLORS.primary },
  "Arreglo": { icon: "●", fullTooth: false, color: COLORS.secondary },
  "Extracción": { icon: "X", fullTooth: true, color: COLORS.primary },
  "P.D": { icon: "X", fullTooth: true, color: COLORS.secondary },
  "Arreglo filtrado": { icon: "◎", fullTooth: false, color: COLORS.secondary },
  "T.C": { icon: "●", fullTooth: false, color: COLORS.primary },
  "Corona": { icon: "⭕", fullTooth: true, color: COLORS.primary },
  "Corona filtrada": { icon: "⭕", fullTooth: true, color: COLORS.secondary },
  "Impl": { icon: "○", fullTooth: false, color: COLORS.gray },
  "A.M": { icon: "●", fullTooth: false, color: COLORS.secondary },
  "Ortodoncia": { icon: "●", fullTooth: false, color: COLORS.green },
  "Protesis": { icon: "[]", requiresTwoTeeth: true, fullTooth: true, color: COLORS.primary }
};

interface Props {
  dni: string;
}

const { dni } = Astro.props;
const BASE_URL = "https://odontoback-production.up.railway.app/api";
---

<div class="w-full max-w-7xl mx-auto bg-gray-800 p-4 md:p-6">
  <!-- Adult Odontogram -->
  <div class="bg-gray-800 mb-8">
    <h2 class="text-xl font-bold text-white mb-6">Odontograma Adulto</h2>
    
    <!-- Treatment Options -->
    <div class="flex flex-wrap gap-3 mb-8 p-4 bg-gray-700 rounded-lg">
      {Object.entries(TREATMENTS).map(([name, {icon, color}]) => (
        <div class="flex items-center gap-2 cursor-pointer hover:scale-105 transition-transform px-2 py-1 rounded-md hover:bg-gray-600" 
             data-treatment={name}>
          <span class="text-sm font-medium text-white">{name}</span>
          <span style={`color: ${color}`}>{icon}</span>
        </div>
      ))}
    </div>

    <!-- Control Panel -->
    <div class="mt-8 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="space-y-1.5">
          <label class="block text-sm font-medium text-gray-300">Tratamiento</label>
          <select id="treatment-select" class="w-full rounded-md border-gray-600 bg-gray-700 text-white focus:ring-2 focus:ring-blue-500" required>
            <option value="">Seleccionar tratamiento</option>
            {Object.entries(TREATMENTS).map(([name]) => (
              <option value={name}>{name}</option>
            ))}
          </select>
        </div>
        <div class="space-y-1.5">
          <label class="block text-sm font-medium text-gray-300">Origen</label>
          <select id="origin-select" class="w-full rounded-md border-gray-600 bg-gray-700 text-white focus:ring-2 focus:ring-blue-500" required>
            <option value="">Seleccionar origen</option>
            <option value="propio">Este estudio</option>
            <option value="otro">Otro estudio</option>
          </select>
        </div>
        <div class="space-y-1.5">
          <label class="block text-sm font-medium text-gray-300">Observaciones</label>
          <textarea id="notes" rows="1" class="w-full rounded-md border-gray-600 bg-gray-700 text-white focus:ring-2 focus:ring-blue-500 resize-none"></textarea>
        </div>
      </div>

      <div class="flex justify-between items-center">
        <div id="notification" class="hidden px-4 py-2 rounded-md"></div>
        <div class="flex space-x-3">
          <button id="clear-all" class="px-4 py-2 border border-red-600 rounded-md text-red-300 hover:bg-red-700/20 transition-colors">
            Limpiar Todo
          </button>
          <button id="reset" class="px-4 py-2 border border-gray-600 rounded-md text-gray-300 hover:bg-gray-700 transition-colors">
            Reiniciar
          </button>
          <button id="save" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
            Guardar
          </button>
        </div>
      </div>
    </div>

    <!-- Superior Teeth -->
    <div class="mb-12 mt-8">
      <h3 class="text-center text-sm font-medium text-gray-300 mb-4">Superior</h3>
      <div class="grid grid-cols-16 gap-2 relative">
        {TEETH.superior.map((tooth) => (
          <div class="tooth-container relative" data-tooth={tooth}>
            <span class="tooth-number absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs text-gray-400">{tooth}</span>
            {['11', '21'].includes(tooth.toString()) && 
              <div class={`teeth-separator ${tooth === '11' ? 'right' : 'left'}`}></div>
            }
          </div>
        ))}
      </div>
    </div>

    <!-- Inferior Teeth -->
    <div class="mb-12">
      <h3 class="text-center text-sm font-medium text-gray-300 mb-4">Inferior</h3>
      <div class="grid grid-cols-16 gap-2 relative">
        {TEETH.inferior.map((tooth) => (
          <div class="tooth-container relative" data-tooth={tooth}>
            <span class="tooth-number absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs text-gray-400">{tooth}</span>
            {['41', '31'].includes(tooth.toString()) && 
              <div class={`teeth-separator ${tooth === '41' ? 'right' : 'left'}`}></div>
            }
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Pediatric Odontogram -->
  <div class="bg-gray-800 mt-12 p-6 rounded-lg border-t-2 border-gray-700">
    <h2 class="text-xl font-bold text-white mb-6">Odontograma Pediátrico</h2>

    <!-- Superior Primary Teeth -->
    <div class="mb-12">
      <h3 class="text-center text-sm font-medium text-gray-300 mb-4">Superior - Dientes Temporales</h3>
      <div class="grid grid-cols-10 gap-2 max-w-3xl mx-auto relative">
        {PRIMARY_TEETH.superior.map((tooth) => (
          <div class="tooth-container relative" data-tooth={tooth}>
            <span class="tooth-number absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs text-gray-400">{tooth}</span>
            {['51', '61'].includes(tooth) && 
              <div class={`teeth-separator ${tooth === '51' ? 'right' : 'left'}`}></div>
            }
          </div>
        ))}
      </div>
    </div>

    <!-- Inferior Primary Teeth -->
    <div class="mb-12">
      <h3 class="text-center text-sm font-medium text-gray-300 mb-4">Inferior - Dientes Temporales</h3>
      <div class="grid grid-cols-10 gap-2 max-w-3xl mx-auto relative">
        {PRIMARY_TEETH.inferior.map((tooth) => (
          <div class="tooth-container relative" data-tooth={tooth}>
            <span class="tooth-number absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs text-gray-400">{tooth}</span>
            {['81', '71'].includes(tooth) && 
              <div class={`teeth-separator ${tooth === '81' ? 'right' : 'left'}`}></div>
            }
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Treatment History -->
  <div class="mt-8">
    <h3 class="text-lg font-medium text-white mb-4">Historial de Tratamientos</h3>
    <div class="mb-4">
      <input type="text" 
        id="search-input" 
        placeholder="Buscar por número de diente o tratamiento..." 
        class="w-full md:w-2/4 rounded-md border-gray-600 bg-gray-700 text-white px-4 py-2 focus:ring-2 focus:ring-blue-500"
      />
    </div>
    <div id="treatment-history" class="space-y-2">
      <!-- Treatments will be added here dynamically -->
    </div>
  </div>
</div>

<style>
  .grid-cols-16 {
    grid-template-columns: repeat(16, minmax(0, 1fr));
  }
  
  .grid-cols-10 {
    grid-template-columns: repeat(10, minmax(0, 1fr));
  }
  
  .tooth-container {
    position: relative;
    width: 50px;
    height: 50px;
    margin: auto;
    transition: all 0.2s ease;
  }
  
  .tooth-canvas {
    width: 100%;
    height: 100%;
    cursor: pointer;
    transition: transform 0.2s;
  }
  
  .tooth-container:hover .tooth-canvas {
    transform: scale(1.1);
  }
  
  .tooth-number {
    opacity: 0;
    transition: opacity 0.2s;
  }
  
  .tooth-container:hover .tooth-number {
    opacity: 1;
  }
  
  .tooth-container.own-clinic {
    background-color: rgba(59, 130, 246, 0.1);
    border-radius: 0.5rem;
  }
  
  .tooth-container.other-clinic {
    background-color: rgba(239, 68, 68, 0.1);
    border-radius: 0.5rem;
  }
  
  .protesis-connector {
    pointer-events: none;
    z-index: 10;
    position: absolute;
  }
  
  /* Animation classes */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .notification-animation {
    animation: fadeIn 0.3s ease-out;
  }
  
  /* Focus states */
  select:focus, input:focus, textarea:focus {
    outline: none;
    border-color: rgb(59, 130, 246);
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
  }
  
  /* Responsive adjustments */
  @media (max-width: 768px) {
    .tooth-container {
      width: 40px;
      height: 40px;
    }
    
    .tooth-number {
      font-size: 0.65rem;
    }
  }
  
  @media (max-width: 640px) {
    .tooth-container {
      width: 35px;
      height: 35px;
    }
  }
  </style>

<script define:vars={{ dni, TREATMENTS, BASE_URL, COLORS }}>
  class ToothCanvas {
    constructor(container, size = 50) {
      this.size = size;
      this.container = container;
      this.canvas = document.createElement('canvas');
      this.canvas.width = size;
      this.canvas.height = size;
      this.canvas.className = 'tooth-canvas';
      this.ctx = this.canvas.getContext('2d');
      
      container.appendChild(this.canvas);
      
      this.ctx.strokeStyle = COLORS.gray;
      this.ctx.lineWidth = 2;
  
      this.canvas.addEventListener('click', (e) => {
        const rect = this.canvas.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        this.handleClick(x, y);
      });
    }
  
    clear() {
      this.ctx.clearRect(0, 0, this.size, this.size);
      this.drawToothBase();
    }
  
    drawToothBase() {
      const margin = this.size * 0.25;
      this.ctx.fillStyle = COLORS.background;
      
      // Central
      this.ctx.fillRect(margin, margin, this.size - 2*margin, this.size - 2*margin);
      this.ctx.strokeRect(margin, margin, this.size - 2*margin, this.size - 2*margin);
      
      // Superior
      this.ctx.fillRect(margin, 0, this.size - 2*margin, margin);
      this.ctx.strokeRect(margin, 0, this.size - 2*margin, margin);
      
      // Inferior
      this.ctx.fillRect(margin, this.size - margin, this.size - 2*margin, margin);
      this.ctx.strokeRect(margin, this.size - margin, this.size - 2*margin, margin);
      
      // Izquierda
      this.ctx.fillRect(0, margin, margin, this.size - 2*margin);
      this.ctx.strokeRect(0, margin, margin, this.size - 2*margin);
      
      // Derecha
      this.ctx.fillRect(this.size - margin, margin, margin, this.size - 2*margin);
      this.ctx.strokeRect(this.size - margin, margin, margin, this.size - 2*margin);
    }
  
    handleClick(x, y) {
      const surface = this.getSurfaceFromCoordinates(x, y);
      if (surface) {
        const toothNumber = this.container.dataset.tooth;
        seleccionarParteDiente(toothNumber, surface, this.container);
      }
    }
  
    getSurfaceFromCoordinates(x, y) {
      const normalizedX = x / this.size;
      const normalizedY = y / this.size;
  
      if (normalizedX > 0.25 && normalizedX < 0.75) {
        if (normalizedY < 0.25) return 'superior';
        if (normalizedY > 0.75) return 'inferior';
      }
  
      if (normalizedY > 0.25 && normalizedY < 0.75) {
        if (normalizedX < 0.25) return 'izquierda';
        if (normalizedX > 0.75) return 'derecha';
      }
  
      if (normalizedX > 0.25 && normalizedX < 0.75 && 
          normalizedY > 0.25 && normalizedY < 0.75) {
        return 'central';
      }
  
      return null;
    }
  
    drawExtraction() {
      this.ctx.beginPath();
      this.ctx.strokeStyle = COLORS.primary;
      this.ctx.lineWidth = 3;
      
      // First diagonal line
      this.ctx.moveTo(5, 5);
      this.ctx.lineTo(this.size - 5, this.size - 5);
      
      // Second diagonal line
      this.ctx.moveTo(this.size - 5, 5);
      this.ctx.lineTo(5, this.size - 5);
      
      this.ctx.stroke();
    }
  
    drawPD() {
      this.ctx.beginPath();
      this.ctx.strokeStyle = COLORS.secondary;
      this.ctx.lineWidth = 3;
      
      this.ctx.moveTo(5, 5);
      this.ctx.lineTo(this.size - 5, this.size - 5);
      this.ctx.moveTo(this.size - 5, 5);
      this.ctx.lineTo(5, this.size - 5);
      
      this.ctx.stroke();
    }
  
    drawCoronaFiltrada() {
      this.ctx.beginPath();
      this.ctx.strokeStyle = COLORS.secondary;
      this.ctx.lineWidth = 2;
      
      const padding = 3;
      this.ctx.ellipse(
        this.size/2, 
        this.size/2, 
        this.size/2 - padding, 
        this.size/2 - padding, 
        0, 
        0, 
        2 * Math.PI
      );
      
      this.ctx.stroke();
    }
  
    drawArregloFiltrado(surface) {
      const margin = this.size * 0.25;
      this.ctx.strokeStyle = COLORS.secondary;
      this.ctx.fillStyle = 'transparent';
      this.ctx.lineWidth = 2;
      
      let x, y;
      const radius = margin * 0.6;
      
      switch(surface) {
        case 'central':
          x = this.size/2;
          y = this.size/2;
          break;
        case 'superior':
          x = this.size/2;
          y = margin/2;
          break;
        case 'inferior':
          x = this.size/2;
          y = this.size - margin/2;
          break;
        case 'izquierda':
          x = margin/2;
          y = this.size/2;
          break;
        case 'derecha':
          x = this.size - margin/2;
          y = this.size/2;
          break;
      }
      
      this.ctx.beginPath();
      this.ctx.arc(x, y, radius, 0, 2 * Math.PI);
      this.ctx.stroke();
    }
  
    drawCorona() {
      this.ctx.beginPath();
      this.ctx.strokeStyle = COLORS.primary;
      this.ctx.lineWidth = 2;
      this.ctx.setLineDash([2, 2]); // Make it dashed
      
      const padding = 3;
      this.ctx.ellipse(
        this.size/2, 
        this.size/2, 
        this.size/2 - padding, 
        this.size/2 - padding, 
        0, 
        0, 
        2 * Math.PI
      );
      
      this.ctx.stroke();
      this.ctx.setLineDash([]); // Reset dash
    }
  
    drawProtesisStart() {
      this.ctx.beginPath();
      this.ctx.strokeStyle = COLORS.primary;
      this.ctx.lineWidth = 2;
      
      // Draw bracket [
      this.ctx.moveTo(this.size - 5, 5);
      this.ctx.lineTo(this.size - 15, 5);
      this.ctx.lineTo(this.size - 15, this.size - 5);
      this.ctx.lineTo(this.size - 5, this.size - 5);
      
      this.ctx.stroke();
    }
  
    drawProtesisEnd() {
      this.ctx.beginPath();
      this.ctx.strokeStyle = COLORS.primary;
      this.ctx.lineWidth = 2;
      
      // Draw bracket ]
      this.ctx.moveTo(5, 5);
      this.ctx.lineTo(15, 5);
      this.ctx.lineTo(15, this.size - 5);
      this.ctx.lineTo(5, this.size - 5);
      
      this.ctx.stroke();
    }
  
    drawCaries(surface) {
      const margin = this.size * 0.25;
      this.ctx.fillStyle = COLORS.primary;
      
      let x, y;
      const radius = margin * 0.4;
      
      switch(surface) {
        case 'central':
          x = this.size/2;
          y = this.size/2;
          break;
        case 'superior':
          x = this.size/2;
          y = margin/2;
          break;
        case 'inferior':
          x = this.size/2;
          y = this.size - margin/2;
          break;
        case 'izquierda':
          x = margin/2;
          y = this.size/2;
          break;
        case 'derecha':
          x = this.size - margin/2;
          y = this.size/2;
          break;
      }
      
      this.ctx.beginPath();
      this.ctx.arc(x, y, radius, 0, 2 * Math.PI);
      this.ctx.fill();
    }
  
    drawArreglo(surface) {
      const margin = this.size * 0.25;
      this.ctx.fillStyle = COLORS.secondary;
      
      let x, y;
      const radius = margin * 0.4;
      
      switch(surface) {
        case 'central':
          x = this.size/2;
          y = this.size/2;
          break;
        case 'superior':
          x = this.size/2;
          y = margin/2;
          break;
        case 'inferior':
          x = this.size/2;
          y = this.size - margin/2;
          break;
        case 'izquierda':
          x = margin/2;
          y = this.size/2;
          break;
        case 'derecha':
          x = this.size - margin/2;
          y = this.size/2;
          break;
      }
      
      this.ctx.beginPath();
      this.ctx.arc(x, y, radius, 0, 2 * Math.PI);
      this.ctx.fill();
    }
  
    drawImplante() {
      this.ctx.beginPath();
      this.ctx.strokeStyle = COLORS.gray;
      this.ctx.lineWidth = 2;
      
      const padding = 3;
      this.ctx.ellipse(
        this.size/2, 
        this.size/2, 
        this.size/2 - padding, 
        this.size/2 - padding, 
        0, 
        0, 
        2 * Math.PI
      );
      
      // Add a dot in the center
      this.ctx.stroke();
      this.ctx.beginPath();
      this.ctx.arc(this.size/2, this.size/2, 2, 0, 2 * Math.PI);
      this.ctx.fill();
    }
  
    drawOrtodoncia(surface) {
      const margin = this.size * 0.25;
      this.ctx.fillStyle = COLORS.green;
      
      let x, y;
      const radius = margin * 0.4;
      
      switch(surface) {
        case 'central':
          x = this.size/2;
          y = this.size/2;
          break;
        case 'superior':
          x = this.size/2;
          y = margin/2;
          break;
        case 'inferior':
          x = this.size/2;
          y = this.size - margin/2;
          break;
        case 'izquierda':
          x = margin/2;
          y = this.size/2;
          break;
        case 'derecha':
          x = this.size - margin/2;
          y = this.size/2;
          break;
      }
      
      this.ctx.beginPath();
      this.ctx.arc(x, y, radius, 0, 2 * Math.PI);
      this.ctx.fill();
    }
  
    drawTC(surface) {
      this.drawCaries(surface); // T.C se dibuja igual que Caries
    }
  
    drawAM(surface) {
      this.drawArreglo(surface); // A.M se dibuja igual que Arreglo
    }
  }
  
  let idPacienteDeApi = null;
  let protesisFirstTooth = null;
  let protesisFirstElement = null;
  
  function cargarTratamientosPendientes() {
    try {
      return JSON.parse(localStorage.getItem('tratamientosPendientes') || '[]');
    } catch (error) {
      console.error('Error al cargar tratamientos pendientes:', error);
      return [];
    }
  }
  
  function guardarTratamientosPendientes(tratamientos) {
    try {
      localStorage.setItem('tratamientosPendientes', JSON.stringify(tratamientos));
    } catch (error) {
      console.error('Error al guardar tratamientos pendientes:', error);
      mostrarNotificacion('Error al guardar tratamientos pendientes', 'error');
    }
  }
  
  function initializeToothCanvases() {
  document.querySelectorAll('.tooth-container').forEach(container => {
    const toothCanvas = new ToothCanvas(container);
    container.toothCanvas = toothCanvas;
    toothCanvas.drawToothBase();

    // Agregar separadores verticales para los dientes especificados
    const toothNumber = container.dataset.tooth;
    if (['11', '41', '51', '81'].includes(toothNumber)) {
      const separator = document.createElement('div');
      separator.className = 'teeth-separator right';
      container.appendChild(separator);
    } else if (['21', '31', '61', '71'].includes(toothNumber)) {
      const separator = document.createElement('div');
      separator.className = 'teeth-separator left';
      container.appendChild(separator);
    }
  });
}

function reiniciarCanvas() {
  // Limpiar todos los canvas
  document.querySelectorAll('.tooth-container').forEach(container => {
    if (container.toothCanvas) {
      container.toothCanvas.clear();
      container.toothCanvas.drawToothBase();
    }
    // Remover clases de background
    container.classList.remove('own-clinic', 'other-clinic');
  });
  
  // Remover conectores de prótesis
  document.querySelectorAll('.protesis-connector').forEach(el => el.remove());
}


async function eliminarTratamiento(id) {
  if (!confirm('¿Está seguro de que desea eliminar este tratamiento?')) return;

  try {
    const response = await fetch(`${BASE_URL}/odontograma/${id}`, {
      method: 'DELETE'
    });
    
    if (!response.ok) throw new Error('Error al eliminar tratamiento');
    
    document.querySelector(`[data-id="${id}"]`)?.remove();
    
    // Primero reiniciamos todos los canvas
    reiniciarCanvas();
    
    // Luego recargamos los tratamientos existentes
    await cargarTratamientosExistentes();
    mostrarNotificacion('Tratamiento eliminado exitosamente', 'success');
  } catch (error) {
    console.error('Error:', error);
    mostrarNotificacion('Error al eliminar el tratamiento', 'error');
  }
}
  
  function applyTreatment(container, treatment, surface) {
    const canvas = container.toothCanvas;
    if (!canvas) return;
    
    if (!TREATMENTS[treatment]) {
      console.error(`Tratamiento desconocido: ${treatment}`);
      return;
    }
    
    canvas.clear();
    canvas.drawToothBase();
    
    switch(treatment) {
      case 'Extracción':
        canvas.drawExtraction();
        break;
      case 'P.D':
        canvas.drawPD();
        break;
      case 'Corona filtrada':
        canvas.drawCoronaFiltrada();
        break;
      case 'Arreglo filtrado':
        canvas.drawArregloFiltrado(surface);
        break;
      case 'Corona':
        canvas.drawCorona();
        break;
      case 'Caries':
        canvas.drawCaries(surface);
        break;
      case 'Arreglo':
        canvas.drawArreglo(surface);
        break;
      case 'Impl':
        canvas.drawImplante();
        break;
      case 'Ortodoncia':
        canvas.drawOrtodoncia(surface);
        break;
      case 'T.C':
        canvas.drawTC(surface);
        break;
      case 'A.M':
        canvas.drawAM(surface);
        break;
    }
  }
  
  function handleProtesis(startContainer, endContainer) {
    if (!startContainer || !endContainer) return;
    
    startContainer.toothCanvas.clear();
    endContainer.toothCanvas.clear();
    startContainer.toothCanvas.drawToothBase();
    endContainer.toothCanvas.drawToothBase();
    startContainer.toothCanvas.drawProtesisStart();
    endContainer.toothCanvas.drawProtesisEnd();
    // Crear el canvas conector
  const connector = document.createElement('canvas');
  connector.className = 'protesis-connector';
  connector.style.position = 'absolute';
  
  const startRect = startContainer.getBoundingClientRect();
  const endRect = endContainer.getBoundingClientRect();
  const parentRect = startContainer.parentElement.getBoundingClientRect();
  
  connector.style.top = `${startRect.top + startRect.height/2 - parentRect.top}px`;
  connector.style.left = `${startRect.left + startRect.width - parentRect.left}px`;
  connector.width = endRect.left - startRect.right;
  connector.height = 2;
  
  const ctx = connector.getContext('2d');
  ctx.strokeStyle = COLORS.primary;
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.moveTo(0, 1);
  ctx.lineTo(connector.width, 1);
  ctx.stroke();
  
  startContainer.parentElement.appendChild(connector);
}

function seleccionarParteDiente(diente, superficie, elemento) {
  const tratamiento = document.getElementById('treatment-select')?.value;
  const origen = document.getElementById('origin-select')?.value;
  
  if (!tratamiento || !origen) {
    mostrarNotificacion('Seleccione tratamiento y origen', 'error');
    return;
  }

  // Aplicar clase de background según origen
  elemento.classList.remove('own-clinic', 'other-clinic');
  elemento.classList.add(origen === 'propio' ? 'own-clinic' : 'other-clinic');

  if (tratamiento === 'Protesis') {
    if (!protesisFirstTooth) {
      protesisFirstTooth = elemento;
      protesisFirstElement = elemento;
      mostrarNotificacion('Seleccione el segundo diente para la prótesis', 'success');
      return;
    }
    
    const firstNum = parseInt(protesisFirstTooth.dataset.tooth);
    const secondNum = parseInt(diente);
    
    if (Math.floor(firstNum/10) !== Math.floor(secondNum/10)) {
      mostrarNotificacion('Los dientes deben estar en la misma fila', 'error');
      return;
    }
    
    if (Math.abs(secondNum - firstNum) > 7) {
      mostrarNotificacion('Los dientes están demasiado separados', 'error');
      return;
    }
    
    handleProtesis(protesisFirstTooth, elemento);
    
    const tratamientosPendientes = cargarTratamientosPendientes();
    tratamientosPendientes.push(
      {
        numeroDiente: protesisFirstTooth.dataset.tooth,
        superficie: 'completo',
        tratamiento: 'Protesis',
        origen,
        protesisPartner: diente
      },
      {
        numeroDiente: diente,
        superficie: 'completo',
        tratamiento: 'Protesis',
        origen,
        protesisPartner: protesisFirstTooth.dataset.tooth
      }
    );
    
    guardarTratamientosPendientes(tratamientosPendientes);
    document.getElementById('save').disabled = false;
    
    protesisFirstTooth = null;
    protesisFirstElement = null;
  } else {
    const tratamientoInfo = TREATMENTS[tratamiento];
    if (!tratamientoInfo) return;
    
    const tratamientosPendientes = cargarTratamientosPendientes();
    
    if (tratamientoInfo.fullTooth) {
      applyTreatment(elemento, tratamiento, 'completo');
      tratamientosPendientes.push({
        numeroDiente: diente,
        superficie: 'completo',
        tratamiento,
        origen
      });
    } else {
      applyTreatment(elemento, tratamiento, superficie);
      tratamientosPendientes.push({
        numeroDiente: diente,
        superficie,
        tratamiento,
        origen
      });
    }
    
    guardarTratamientosPendientes(tratamientosPendientes);
    document.getElementById('save').disabled = false;
  }
}

async function guardarTratamiento() {
  const tratamientosPendientes = cargarTratamientosPendientes();
  if (tratamientosPendientes.length === 0) {
    mostrarNotificacion('No hay tratamientos pendientes', 'error');
    return;
  }

  const botonGuardar = document.getElementById('save');
  if (!botonGuardar) return;
  
  botonGuardar.disabled = true;
  botonGuardar.innerHTML = '<span class="animate-pulse">Guardando...</span>';

  try {
    if (!idPacienteDeApi) {
      throw new Error('ID de paciente no disponible');
    }

    const notas = document.getElementById('notes')?.value || '';
    const datosDientes = tratamientosPendientes.map(t => ({
      numeroDiente: t.numeroDiente.toString(),
      superficie: t.superficie,
      tratamiento: t.tratamiento,
      origen: t.origen,
      notas,
      protesisPartner: t.protesisPartner
    }));

    const respuesta = await fetch(`${BASE_URL}/odontograma`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        idPaciente: idPacienteDeApi,
        dientes: datosDientes
      })
    });

    if (!respuesta.ok) {
      throw new Error(await respuesta.text());
    }
    
    localStorage.removeItem('tratamientosPendientes');
    
    const tratamientSelect = document.getElementById('treatment-select');
    const originSelect = document.getElementById('origin-select');
    const notesTextarea = document.getElementById('notes');
    
    if (tratamientSelect) tratamientSelect.value = '';
    if (originSelect) originSelect.value = '';
    if (notesTextarea) notesTextarea.value = '';
    if (botonGuardar) botonGuardar.disabled = true;

    await cargarTratamientosExistentes();
    
    mostrarNotificacion('Tratamientos guardados exitosamente', 'success');
  } catch (error) {
    console.error('Error detallado:', error);
    mostrarNotificacion(
      `Error al guardar los tratamientos: ${error.message || 'Error desconocido'}`, 
      'error'
    );
  } finally {
    if (botonGuardar) {
      botonGuardar.disabled = false;
      botonGuardar.innerHTML = 'Guardar';
    }
  }
}

async function cargarTratamientosExistentes() {
  try {
    if (!idPacienteDeApi) throw new Error('ID de paciente no disponible');
    
    const respuesta = await fetch(`${BASE_URL}/odontograma/patient/${idPacienteDeApi}`);
    if (!respuesta.ok) throw new Error('Error al cargar tratamientos');
    
    const tratamientos = JSON.parse(await respuesta.text());
    const contenedorHistorial = document.getElementById('treatment-history');
    if (!contenedorHistorial) return;

    contenedorHistorial.innerHTML = '';

    if (!Array.isArray(tratamientos) || tratamientos.length === 0) {
      contenedorHistorial.innerHTML = '<div class="text-gray-400 text-center py-4">No hay tratamientos registrados</div>';
      // Asegurarnos de limpiar todos los canvas si no hay tratamientos
      reiniciarCanvas();
      return;
    }

    tratamientos.sort((a, b) => new Date(b.fecha) - new Date(a.fecha));

    // Primero limpiamos todos los canvas
    reiniciarCanvas();

    // Luego aplicamos los tratamientos existentes
    tratamientos.forEach(odontograma => {
      odontograma.dientes.forEach(diente => {
        aplicarTratamientoExistente(diente);
        agregarTratamientoAlHistorial(diente, odontograma.fecha, odontograma._id);
      });
    });
  } catch (error) {
    console.error('Error al cargar tratamientos:', error);
    mostrarNotificacion('Error al cargar tratamientos', 'error');
  }
}

function aplicarTratamientoExistente(diente) {
  const container = document.querySelector(`[data-tooth="${diente.numeroDiente}"]`);
  if (!container || !container.toothCanvas) return;

  // Aplicar clase de background según origen
  container.classList.remove('own-clinic', 'other-clinic');
  container.classList.add(diente.origen === 'propio' ? 'own-clinic' : 'other-clinic');

  if (diente.tratamiento === 'Protesis' && diente.protesisPartner) {
    const partnerContainer = document.querySelector(`[data-tooth="${diente.protesisPartner}"]`);
    if (partnerContainer && parseInt(diente.numeroDiente) < parseInt(diente.protesisPartner)) {
      handleProtesis(container, partnerContainer);
    }
  } else {
    applyTreatment(container, diente.tratamiento, diente.superficie);
  }
}

function agregarTratamientoAlHistorial(diente, fecha, id) {
  const contenedorHistorial = document.getElementById('treatment-history');
  if (!contenedorHistorial) return;

  const tratamiento = TREATMENTS[diente.tratamiento];
  if (!tratamiento) return;
  
  const registroTratamiento = document.createElement('div');
  registroTratamiento.className = 'mb-2 px-4 py-3 bg-gray-700/50 backdrop-blur rounded-lg';
  registroTratamiento.dataset.id = id;
  registroTratamiento.dataset.fecha = new Date(fecha).getTime();
  registroTratamiento.dataset.searchContent = `${diente.numeroDiente} ${diente.tratamiento}`.toLowerCase();
  
  const isPrimary = ['5','6','7','8'].includes(diente.numeroDiente.toString().charAt(0));
  const dentitionType = isPrimary ? '(Temporal)' : '(Permanente)';
  
  registroTratamiento.innerHTML = `
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="font-medium text-white">Diente ${diente.numeroDiente} ${dentitionType}</span>
        <span class="text-lg" style="color: ${tratamiento.color}">${tratamiento.icon}</span>
        <span class="${diente.origen === 'propio' ? 'text-blue-400' : 'text-red-400'} text-sm">
          ${diente.origen === 'propio' ? 'Este estudio' : 'Otro estudio'}
        </span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-sm text-gray-400">${new Date(fecha).toLocaleDateString()}</span>
        <button onclick="eliminarTratamiento('${id}')" class="text-gray-400 hover:text-red-400 transition-colors">
          <span class="text-lg">🗑️</span>
        </button>
      </div>
    </div>
    <div class="mt-1.5 text-sm text-gray-300 flex gap-1 items-center">
      <span>${diente.tratamiento}</span>
      <span class="text-gray-500">-</span>
      <span>${diente.superficie}</span>
      ${diente.protesisPartner ? `<span class="text-gray-500">- Conectado con ${diente.protesisPartner}</span>` : ''}
    </div>
    ${diente.notas ? `
      <div class="mt-1.5 text-sm text-gray-400 flex items-center gap-1">
        <span>📝</span>
        <span>${diente.notas}</span>
      </div>
    ` : ''}
  `;

  const registros = Array.from(contenedorHistorial.children);
  const index = registros.findIndex(r => parseInt(r.dataset.fecha || '0') < new Date(fecha).getTime());

  if (index === -1) {
    contenedorHistorial.appendChild(registroTratamiento);
  } else {
    contenedorHistorial.insertBefore(registroTratamiento, registros[index]);
  }
}

async function eliminarTratamiento(id) {
  if (!confirm('¿Está seguro de que desea eliminar este tratamiento?')) return;

  try {
    const response = await fetch(`${BASE_URL}/odontograma/${id}`, {
      method: 'DELETE'
    });
    
    if (!response.ok) throw new Error('Error al eliminar tratamiento');
    
    document.querySelector(`[data-id="${id}"]`)?.remove();
    await cargarTratamientosExistentes();
    mostrarNotificacion('Tratamiento eliminado exitosamente', 'success');
  } catch (error) {
    console.error('Error:', error);
    mostrarNotificacion('Error al eliminar el tratamiento', 'error');
  }
}

async function limpiarTodo() {
  if (!confirm('¿Está seguro de que desea eliminar todos los tratamientos?')) return;

  try {
    if (!idPacienteDeApi) throw new Error('ID de paciente no disponible');
    
    const response = await fetch(`${BASE_URL}/odontograma/patient/${idPacienteDeApi}`, {
      method: 'DELETE'
    });
    
    if (!response.ok) throw new Error('Error al eliminar tratamientos');
    
    localStorage.removeItem('tratamientosPendientes');
    
    const elements = {
      treatmentSelect: document.getElementById('treatment-select'),
      originSelect: document.getElementById('origin-select'),
      notes: document.getElementById('notes'),
      save: document.getElementById('save'),
      treatmentHistory: document.getElementById('treatment-history')
    };
    
    if (elements.treatmentSelect) elements.treatmentSelect.value = '';
    if (elements.originSelect) elements.originSelect.value = '';
    if (elements.notes) elements.notes.value = '';
    if (elements.save) elements.save.disabled = true;
    
    // Usar la nueva función reiniciarCanvas
    reiniciarCanvas();
    
    if (elements.treatmentHistory) {
      elements.treatmentHistory.innerHTML = 
        '<div class="text-gray-400 text-center py-4">No hay tratamientos registrados</div>';
    }
    
    mostrarNotificacion('Todos los tratamientos eliminados', 'success');
  } catch (error) {
    console.error('Error:', error);
    mostrarNotificacion('Error al eliminar los tratamientos', 'error');
  }
}

function mostrarNotificacion(mensaje, tipo = 'success') {
  const notificacionExistente = document.querySelector('.notificacion');
  if (notificacionExistente) {
    notificacionExistente.remove();
  }

  const notificacion = document.createElement('div');
  notificacion.className = `notificacion fixed right-4 top-4 z-50 rounded-lg p-4 shadow-lg transition-opacity duration-300 ${
    tipo === 'success' 
      ? 'bg-green-500' 
      : 'bg-red-500'
  } text-white`;
  notificacion.textContent = mensaje;

  document.body.appendChild(notificacion);

  setTimeout(() => {
    notificacion.style.opacity = '0';
    setTimeout(() => notificacion.remove(), 300);
  }, 3000);
}

function buscarTratamientos(query) {
  const contenedorHistorial = document.getElementById('treatment-history');
  const queryLower = query.toLowerCase();
  
  Array.from(contenedorHistorial.children).forEach(registro => {
    if (!registro.dataset.searchContent) return;
    const visible = registro.dataset.searchContent.includes(queryLower);
    registro.style.display = visible ? 'block' : 'none';
  });
}

function reiniciarSeleccion() {
  localStorage.removeItem('tratamientosPendientes');
  
  // Usar la nueva función reiniciarCanvas
  reiniciarCanvas();
  
  // Resetear variables
  protesisFirstTooth = null;
  protesisFirstElement = null;
  
  // Limpiar controles
  document.getElementById('treatment-select').value = '';
  document.getElementById('origin-select').value = '';
  document.getElementById('notes').value = '';
  document.getElementById('save').disabled = true;
}

// Inicialización
document.addEventListener("DOMContentLoaded", async () => {
  try {
    const respuesta = await fetch(`${BASE_URL}/paciente/findByDni/${dni}`);
    if (!respuesta.ok) throw new Error('Paciente no encontrado');
    
    const datos = JSON.parse(await respuesta.text());
    idPacienteDeApi = datos.paciente?.id;
    
    if (!idPacienteDeApi) {
      mostrarNotificacion('Error: ID de paciente no encontrado', 'error');
      return;
    }

    // Inicializar canvas
    initializeToothCanvases();

    // Cargar tratamientos existentes
    await cargarTratamientosExistentes();
    
    // Cargar tratamientos pendientes
    const tratamientosPendientes = cargarTratamientosPendientes();
    tratamientosPendientes.forEach(t => {
      const container = document.querySelector(`[data-tooth="${t.numeroDiente}"]`);
      if (container && container.toothCanvas) {
        if (t.tratamiento === 'Protesis' && t.protesisPartner) {
          const partnerContainer = document.querySelector(`[data-tooth="${t.protesisPartner}"]`);
          if (partnerContainer && parseInt(t.numeroDiente) < parseInt(t.protesisPartner)) {
            handleProtesis(container, partnerContainer);
          }
        } else {
          applyTreatment(container, t.tratamiento, t.superficie);
        }
      }
    });

    // Inicializar estado del botón guardar
    document.getElementById("save").disabled = tratamientosPendientes.length === 0;

    // Agregar listeners para los controles
    document.querySelectorAll('[data-treatment]').forEach(elem => {
      elem.addEventListener('click', () => {
        document.getElementById('treatment-select').value = elem.dataset.treatment;
      });
    });

    document.getElementById('search-input').addEventListener('input', (e) => {
      buscarTratamientos(e.target.value);
    });

    document.getElementById('save').addEventListener('click', guardarTratamiento);
    document.getElementById('reset').addEventListener('click', reiniciarSeleccion);
    document.getElementById('clear-all').addEventListener('click', limpiarTodo);

  } catch (error) {
    console.error('Error al cargar paciente:', error);
    mostrarNotificacion('Error al cargar paciente', 'error');
  }
});

// Exponer función necesaria para el onclick del historial
window.eliminarTratamiento = eliminarTratamiento;
</script>